				standby.Parent = char
				bindDisabledWatcher(char, standby, otherRig)
			end
		end)
	end

	local function init(playersService, workspaceService, player)
		local target = player or LocalPlayer
		if not target then
			return
		end
		if target.Character then
			ensureDualAnimateOnExisting(target.Character)
		end
		table.insert(globalConns, target.CharacterAdded:Connect(function(newChar)
			if not newChar:GetAttribute("SensationManagedRig") then
				ensureDualAnimateOnExisting(newChar)
			end
		end))
	end

	local function getDescription(playersService, player, curHum)
		local uid = (player.CharacterAppearanceId and player.CharacterAppearanceId > 0) and player.CharacterAppearanceId or player.UserId
		if uid and uid > 0 and descCache[uid] then
			local okClone, cloned = pcall(descCache[uid].Clone, descCache[uid])
			if okClone and cloned then
				return cloned
			end
		end
		if uid and uid > 0 then
			local ok, desc = pcall(playersService.GetHumanoidDescriptionFromUserIdAsync, playersService, uid)
			if ok and desc then
				local okSave, cacheCopy = pcall(desc.Clone, desc)
				if okSave and cacheCopy then
					descCache[uid] = cacheCopy
				end
				return desc
			end
		end
		if curHum then
			local okApp, appDesc = pcall(curHum.GetAppliedDescription, curHum)
			if okApp and appDesc then
				return appDesc
			end
		end
		return Instance.new("HumanoidDescription")
	end

	local function switchRig(playersService, workspaceService, player, notifyFn)
		local target = player or LocalPlayer
		if not target or switchingLock then
			return
		end
		local oldChar = target.Character
		if not oldChar then
			return
		end
		local oldHum = oldChar:FindFirstChildOfClass("Humanoid")
		if not oldHum then
			return
		end

		switchingLock = true
		local okSwitch, errSwitch = pcall(function()
			local oldRig = oldHum.RigType
			local newRig = (oldRig == Enum.HumanoidRigType.R15) and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
			local standbyRig = oldRig
			local standbyName = (standbyRig == Enum.HumanoidRigType.R6) and "AnimateR6" or "AnimateR15"

			local curAnimate = oldChar:FindFirstChild("Animate")
			if curAnimate then
				snapshotAnimateFromInstance(curAnimate, oldRig)
			end
			local prevTargetStandby = oldChar:FindFirstChild((newRig == Enum.HumanoidRigType.R6) and "AnimateR6" or "AnimateR15")
			if prevTargetStandby then
				snapshotAnimateFromInstance(prevTargetStandby, newRig)
			end

			local oldPivot = oldChar:GetPivot()
			local oldWalkSpeed = oldHum.WalkSpeed
			local oldUseJumpPower = oldHum.UseJumpPower
			local oldJumpPower = oldHum.JumpPower
			local oldJumpHeight = oldHum.JumpHeight
			local oldRoot = oldChar:FindFirstChild("HumanoidRootPart") or oldChar.PrimaryPart
			local oldVel = oldRoot and oldRoot.AssemblyLinearVelocity or Vector3.zero

			local desc = getDescription(playersService, target, oldHum)
			if not desc then
				return
			end

			local okModel, newChar = pcall(playersService.CreateHumanoidModelFromDescriptionAsync, playersService, desc, newRig)
			if not okModel or not newChar then
				return
			end

			newChar:SetAttribute("SensationManagedRig", true)

			-- Harvest avatar animations generated on newChar.Animate if we had no prior snapshot for newRig, then remove dead server Animate script(s)
			local generatedAnimate = newChar:FindFirstChild("Animate")
			if generatedAnimate and not savedChildrenByRig[newRig] then
				snapshotAnimateFromInstance(generatedAnimate, newRig)
			end
			for _, child in ipairs(newChar:GetChildren()) do
				if child.Name == "Animate" or child.Name == "AnimateR6" or child.Name == "AnimateR15" then
					child:Destroy()
				end
			end

			local newHum = newChar:FindFirstChildOfClass("Humanoid")
			if not newHum then
				newChar:Destroy()
				return
			end
			if not newHum:FindFirstChildOfClass("Animator") then
				local animator = Instance.new("Animator")
				animator.Parent = newHum
			end
			newHum.WalkSpeed = oldWalkSpeed
			pcall(function()
				newHum.UseJumpPower = oldUseJumpPower
				if oldUseJumpPower then
					newHum.JumpPower = oldJumpPower
				else
					newHum.JumpHeight = oldJumpHeight
				end
			end)

			for _, inst in ipairs(newChar:GetDescendants()) do
				if inst:IsA("BasePart") then
					inst.Anchored = false
				end
			end

			local newRoot = newChar:FindFirstChild("HumanoidRootPart")
			if newRoot then
				newChar.PrimaryPart = newRoot
			end
			newChar.Name = target.Name

			-- Build BOTH Animate scripts inside newChar:
			-- 1) Active rig's LocalScript named "Animate" (Disabled = false)
			-- 2) Other rig's LocalScript named "AnimateR15" / "AnimateR6" (Disabled = true)
			local activeScript = buildAnimateLocalScript(newRig, "Animate", false)
			local standbyScript = buildAnimateLocalScript(standbyRig, standbyName, true)
			activeScript.Parent = newChar
			standbyScript.Parent = newChar

			-- Safely return any equipped Tool from oldChar into Backpack before destroying oldChar
			local backpack = target:FindFirstChildOfClass("Backpack")
			local equippedTools = {}
			if backpack then
				for _, ch in ipairs(oldChar:GetChildren()) do
					if ch:IsA("Tool") then
						ch.Parent = backpack
						table.insert(equippedTools, ch)
					end
				end
			end

			-- Refresh pivot right before swapping so movement during async creation isn't lost
			if oldChar.Parent then
				oldPivot = oldChar:GetPivot()
				oldRoot = oldChar:FindFirstChild("HumanoidRootPart") or oldChar.PrimaryPart
				oldVel = oldRoot and oldRoot.AssemblyLinearVelocity or oldVel
			end

			stopCharacterRunners(oldChar)
			local oldAnimator = oldHum:FindFirstChildOfClass("Animator")
			if oldAnimator then
				for _, trk in ipairs(oldAnimator:GetPlayingAnimationTracks()) do
					pcall(function()
						trk:Stop(0)
					end)
				end
			end

			newChar:PivotTo(oldPivot)
			newChar.Parent = workspaceService
			if newRoot then
				pcall(function()
					newRoot.AssemblyLinearVelocity = oldVel
				end)
			end
			target.Character = newChar
			pcall(function()
				oldChar:Destroy()
			end)

			local cam = workspaceService.CurrentCamera
			if cam then
				cam.CameraSubject = newHum
			end
			task.defer(function()
				local c2 = workspaceService.CurrentCamera
				if c2 and newHum and newHum.Parent then
					c2.CameraSubject = newHum
				end
			end)

			local setActiveTok = bindDisabledWatcher(newChar, activeScript, newRig)
			bindDisabledWatcher(newChar, standbyScript, standbyRig)
			local tok = startRunnerOnScript(newChar, activeScript, newRig)
			setActiveTok(tok)

			for _, tl in ipairs(equippedTools) do
				if tl.Parent == backpack and newHum.Parent then
					pcall(newHum.EquipTool, newHum, tl)
				end
			end

			if notifyFn then
				notifyFn(string.format("Changed Character Rig From %s To %s", oldRig.Name, newRig.Name))
			end
		end)
		switchingLock = false
		if not okSwitch then
			warn("[SensationHub Rig] " .. tostring(errSwitch))
		end
	end

	return {
		init = init,
		switchRig = switchRig,
	}
end)()

