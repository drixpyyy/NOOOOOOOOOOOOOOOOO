local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
assert(player, "Run Facility on a Roblox client (LocalPlayer required).")

local prev = _G.__FACILITY_SINGLE_FILE__
if prev and type(prev.stop) == "function" then
    pcall(prev.stop)
end

local S = {
    alive = true,
    connections = {},
    resources = {},
    hiddenEffects = {},
    spawnedShapes = {},
    powerOn = true,
    powerBusy = false,
    manualHold = false,
    powerEpoch = 0,
    flashlightOn = false,
    hudVisible = true,
    stopped = false,
}
_G.__FACILITY_SINGLE_FILE__ = S

local function conn(sig, fn)
    local c = sig:Connect(fn)
    table.insert(S.connections, c)
    return c
end

local function res(inst)
    table.insert(S.resources, inst)
    return inst
end

-- Embedded asset backups (used automatically via getcustomasset if rbxassetid fails to load)
local function getAssetBackup()
    local audio = {
        ["1841798430"] = "",
        ["314221915"] = "",
        ["9113085665"] = "",
        ["9119720940"] = "",
    }
    local image = {
        ["11336311330"] = "",
        ["1361097"] = "",
        ["13771418863"] = "",
        ["18879587065"] = "",
        ["5673665930"] = "",
        ["71169889480271"] = "",
    }
    return audio, image
end

local localAssets = {}
local backupReady = false

local function decodeBase64(data)
    if buffer and buffer.create then
        local out = buffer.create(#data * 3 // 4 + 4)
        local size, acc, bits = 0, 0, 0
        for i = 1, #data do
            local byte = string.byte(data, i)
            local value
            if byte >= 65 and byte <= 90 then
                value = byte - 65
            elseif byte >= 97 and byte <= 122 then
                value = byte - 71
            elseif byte >= 48 and byte <= 57 then
                value = byte + 4
            elseif byte == 43 then
                value = 62
            elseif byte == 47 then
                value = 63
            end
            if value then
                acc = acc * 64 + value
                bits += 6
                if bits >= 8 then
                    bits -= 8
                    local scale = 2 ^ bits
                    buffer.writeu8(out, size, math.floor(acc / scale) % 256)
                    size += 1
                    acc = acc % scale
                end
            end
        end
        local exact = buffer.create(size)
        buffer.copy(exact, 0, out, 0, size)
        return buffer.tostring(exact)
    else
        local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local cleaned = string.gsub(data, "[^" .. b .. "=]", "")
        return (string.gsub(cleaned, ".", function(x)
            if x == "=" then return "" end
            local r, f = "", string.find(b, x) - 1
            for i = 6, 1, -1 do
                r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0")
            end
            return r
        end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
            if #x ~= 8 then return "" end
            local c = 0
            for i = 1, 8 do
                c = c + (string.sub(x, i, i) == "1" and 2 ^ (8 - i) or 0)
            end
            return string.char(c)
        end))
    end
end

local function prepareBackupAssetsAsync()
    if not (writefile and getcustomasset) then
        backupReady = true
        return
    end
    task.spawn(function()
        local folder = "facility_assets"
        pcall(function()
            if isfolder and makefolder and not isfolder(folder) then
                makefolder(folder)
            end
        end)
        local audioB64, imageB64 = getAssetBackup()
        for id, b64 in pairs(audioB64) do
            if not S.alive then return end
            local path = folder .. "/" .. id .. ".ogg"
            local exists = false
            pcall(function() exists = isfile and isfile(path) end)
            if not exists then
                pcall(writefile, path, decodeBase64(b64))
                task.wait()
            end
            local ok, url = pcall(getcustomasset, path)
            if ok and type(url) == "string" and url ~= "" then
                localAssets[id] = url
            end
        end
        for id, b64 in pairs(imageB64) do
            if not S.alive then return end
            local path = folder .. "/" .. id .. ".png"
            local exists = false
            pcall(function() exists = isfile and isfile(path) end)
            if not exists then
                pcall(writefile, path, decodeBase64(b64))
                task.wait()
            end
            local ok, url = pcall(getcustomasset, path)
            if ok and type(url) == "string" and url ~= "" then
                localAssets[id] = url
            end
        end
        backupReady = true
    end)
end

