local function restoreAssets()
    if not next(localAssets) then return end
    for _, item in ipairs(trackedAssets) do
        local obj = item.obj
        if obj and obj.Parent then
            local fallbackUrl = localAssets[item.id]
            if fallbackUrl then
                local okCur, curVal = pcall(function() return obj[item.prop] end)
                if okCur and curVal ~= fallbackUrl then
                    local loaded = true
                    pcall(function()
                        if obj:IsA("Sound") then
                            loaded = obj.IsLoaded and obj.TimeLength > 0
                        else
                            loaded = obj.IsLoaded ~= false
                        end
                    end)
                    if not loaded then
                        local wasPlaying = false
                        if obj:IsA("Sound") then
                            wasPlaying = obj.IsPlaying or obj.Playing
                        end
                        pcall(function() obj[item.prop] = fallbackUrl end)
                        if wasPlaying and obj:IsA("Sound") then
                            pcall(function() obj:Play() end)
                        end
                    end
                end
            end
        end
    end
end

