local function stop()
    if S.stopped then return end
    S.stopped = true
    S.alive = false
    S.powerEpoch += 1

    local chPre = player.Character
    local humPre = chPre and chPre:FindFirstChildOfClass("Humanoid")
    if humPre and humPre.Sit then
        pcall(function() humPre.Sit = false end)
    end

    for _, c in ipairs(S.connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(S.connections)

    for _, item in ipairs(S.resources) do
        pcall(function()
            if item and item.Parent then
                item:Destroy()
            end
        end)
    end
    table.clear(S.resources)

    for _, h in ipairs(S.hiddenEffects) do
        pcall(function()
            if h.kind == "parent" then
                h.inst.Parent = h.prev
            elseif h.kind == "enabled" then
                h.inst.Enabled = h.prev
            end
        end)
    end

    Lighting.ClockTime = old.ClockTime
    Lighting.TimeOfDay = old.TimeOfDay
    Lighting.Brightness = old.Brightness
    Lighting.Ambient = old.Ambient
    Lighting.OutdoorAmbient = old.OutdoorAmbient
    Lighting.FogColor = old.FogColor
    Lighting.FogStart = old.FogStart
    Lighting.FogEnd = old.FogEnd
    Lighting.EnvironmentDiffuseScale = old.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = old.EnvironmentSpecularScale
    Lighting.GlobalShadows = old.GlobalShadows
    Lighting.ShadowSoftness = old.ShadowSoftness
    Lighting.ExposureCompensation = old.ExposureCompensation
    Lighting.GeographicLatitude = old.GeographicLatitude
    Lighting.ColorShift_Top = old.ColorShift_Top
    Lighting.ColorShift_Bottom = old.ColorShift_Bottom
    if old.Outlines ~= nil then pcall(function() Lighting.Outlines = old.Outlines end) end
    if old.Technology ~= nil then pcall(function() Lighting.Technology = old.Technology end) end
    if old.LightingStyle ~= nil then pcall(function() Lighting.LightingStyle = old.LightingStyle end) end

    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, old.PlayerListEnabled) end)
    pcall(function() SoundService.AmbientReverb = old.AmbientReverb end)
    player.CameraMinZoomDistance = old.CameraMinZoomDistance
    player.CameraMaxZoomDistance = old.CameraMaxZoomDistance
    player.CameraMode = old.CameraMode

    if old.RootCFrame then
        local ch = player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = old.RootCFrame
            end)
        end
    end

    if _G.__FACILITY_SINGLE_FILE__ == S then
        _G.__FACILITY_SINGLE_FILE__ = nil
    end
end
S.stop = stop

makeBtn(108, "[Backspace] Exit  |  [H] Hide", function()
    stop()
end)

conn(UserInputService.InputBegan, function(input, gameProcessed)
    if gameProcessed or not S.alive then return end
    if input.KeyCode == Enum.KeyCode.F then
        toggleFlashlight()
    elseif input.KeyCode == Enum.KeyCode.P then
        togglePowerManual()
    elseif input.KeyCode == Enum.KeyCode.R then
        teleportToFacilitySpawn(player.Character)
    elseif input.KeyCode == Enum.KeyCode.H then
        S.hudVisible = not S.hudVisible
        panel.Visible = S.hudVisible
    elseif input.KeyCode == Enum.KeyCode.Backspace then
        stop()
    end
end)

-- Decode local asset fallbacks asynchronously & swap any unloaded Sound/Texture/Decal/Sky
prepareBackupAssetsAsync()
task.spawn(function()
    for _, waitSec in ipairs({ 2.5, 4.0, 6.0, 8.0 }) do
        if not S.alive then return end
        task.wait(waitSec)
        if not S.alive then return end
        if backupReady or next(localAssets) then
            restoreAssets()
        end
    end
end)

end),
entry("Granny(Client)", function()
-- granny 1.0 skidded bad convert to luau
local SOUND_IDS={
    menu="",pickup_keys="",pickup_items="",drop_hammer="",drop_code="",
    drop_keys="",fall_metal="",break_wood="",click_lock="",
    fall_padlock="",fall_wood="",fall_can="",door_open="",
    door_close="",cabinet_open="",drawer_open="",
    footstep_1="",footstep_2="",footstep_3="",footstep_4="",
    footstep_5="",footstep_dirt_1="",footstep_dirt_2="",
    trap_place="",trap_snap="",trap_release="",creak="",
    door_rattle="",door_unlock="",safe_open="",catch_hit="",
    drop_book="",drop_pliers="",drop_paint="",
}
local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local RS=game:GetService("RunService")
local AS=game:GetService("AssetService")
local Lighting=game:GetService("Lighting")
local player=Players.LocalPlayer
assert(player,"Run this on a Roblox client, not the server.")
assert(buffer and Content and Content.fromObject,"EditableMesh/EditableImage and buffer APIs are required.")
local previous=_G.__GRANNY_SINGLE_FILE__
if previous and previous.stop then pcall(previous.stop) end
local S={alive=true, connections={}, resources={}, active=false, position=nil,
    moveAxis=Vector2.zero,camYaw=0,camPitch=0,headBob=0,walkBlend=0}
_G.__GRANNY_SINGLE_FILE__=S
local function conn(signal,callback)
    local c=signal:Connect(callback);S.connections[#S.connections+1]=c;return c
end
local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local character=player.Character or player.CharacterAdded:Wait()
local root=character:WaitForChild("HumanoidRootPart")
local humanoid=character:FindFirstChildOfClass("Humanoid")
local camera=workspace.CurrentCamera
local old={root=root.CFrame,anchored=root.Anchored,camType=camera.CameraType,camSubject=camera.CameraSubject,
    mouse=UIS.MouseBehavior,icon=UIS.MouseIconEnabled,parts={},speed=humanoid and humanoid.WalkSpeed,
    jump=humanoid and humanoid.JumpPower,rot=humanoid and humanoid.AutoRotate,
    cameraOffset=humanoid and humanoid.CameraOffset,mode=player.CameraMode,
    minZoom=player.CameraMinZoomDistance,maxZoom=player.CameraMaxZoomDistance,fov=camera.FieldOfView,
    clock=Lighting.ClockTime,ambient=Lighting.Ambient,outdoor=Lighting.OutdoorAmbient,
    brightness=Lighting.Brightness,fog=Lighting.FogEnd,fogColor=Lighting.FogColor,
    exposure=Lighting.ExposureCompensation}
for _,p in ipairs(character:GetDescendants()) do
    if p:IsA("BasePart") then old.parts[p]={p.CanCollide,p.CanTouch,p.LocalTransparencyModifier} end
end
conn(character.DescendantAdded,function(p)
    -- Avatar clothing/accessories may finish loading after the scene starts.
    if p:IsA("BasePart") and not old.parts[p] then
        old.parts[p]={p.CanCollide,p.CanTouch,p.LocalTransparencyModifier}
        p.CanCollide=false;p.CanTouch=false
    end
end)
-- Match the supplied size-changer formula, with another half stud removed to fit
-- the imported house. The original character scale is restored on exit.
-- Keep this separate from the big, unrelated Sensation Hub; never execute its bundle.
local originalScale=character:GetScale()
local avatarFactor=1-math.min(1.5/math.max(character:GetExtentsSize().Y,2),.5)
local scaled,scaleErr=pcall(function() character:ScaleTo(originalScale*avatarFactor) end)
if not scaled then avatarFactor=1;warn("Avatar scaling unavailable: "..tostring(scaleErr)) end
-- Preserve the player's own body and animations. Imported scene uses a client-side
-- triangle collision controller because the house render meshes are non-collidable.
local feetY=math.huge
for _,part in ipairs(character:GetDescendants()) do
    if part:IsA("BasePart") and part~=root and not part:FindFirstAncestorOfClass("Accessory") then
        feetY=math.min(feetY,part.Position.Y-part.Size.Y*.5)
    end
end
-- Place the scaled avatar's lowest real body part just above the imported
-- floors. Leave a little clearance for the animated legs; the head-following
-- camera below still follows the actual Head, not a detached camera proxy.
local footToRoot=feetY<math.huge
    and clamp(root.Position.Y-feetY+.24,1.95,4.7) or 3.04
local avatarTracks={}
local avatarAnimate=nil
local oldAnimateEnabled=nil
local model=Instance.new("Model")
model.Name="Granny 1.0 • Sketchfab source scene (client)";model.Parent=workspace
local gui=Instance.new("ScreenGui")
gui.Name="GRANNY_Sketchfab_UI";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.DisplayOrder=100;gui.Parent=player:WaitForChild("PlayerGui")
local function stop()
    if not S.alive then return end
    S.alive=false
    for _,c in ipairs(S.connections) do pcall(function() c:Disconnect() end) end
    pcall(function() RS:UnbindFromRenderStep("GRANNY_Sketchfab_Camera") end)
    if S.restoreArm then pcall(S.restoreArm) end
    if S.tool then pcall(function() S.tool:Destroy() end) end
    if S.toolEditable then pcall(function() S.toolEditable:Destroy() end) end
    if model.Parent then model:Destroy() end
    if gui.Parent then gui:Destroy() end
    for _,r in ipairs(S.resources) do pcall(function() r:Destroy() end) end
    for _,track in ipairs(avatarTracks) do pcall(function() track:Stop(0);track:Destroy() end) end
    if avatarAnimate and avatarAnimate.Parent and oldAnimateEnabled~=nil then
        pcall(function() avatarAnimate.Enabled=oldAnimateEnabled end)
    end
    if root.Parent then pcall(function()
        if scaled then character:ScaleTo(originalScale) end
        root.CFrame=old.root;root.Anchored=old.anchored
    end) end
    for p,pr in pairs(old.parts) do
        if p.Parent then pcall(function() p.CanCollide=pr[1];p.CanTouch=pr[2];p.LocalTransparencyModifier=pr[3] end) end
    end
    if humanoid and humanoid.Parent then pcall(function()
        humanoid.WalkSpeed=old.speed;humanoid.JumpPower=old.jump;humanoid.AutoRotate=old.rot
        humanoid.CameraOffset=old.cameraOffset
    end) end
    pcall(function()
        player.CameraMode=old.mode
        player.CameraMaxZoomDistance=old.maxZoom;player.CameraMinZoomDistance=old.minZoom
        camera.CameraType=old.camType;camera.CameraSubject=old.camSubject;camera.FieldOfView=old.fov
    end)
    pcall(function() UIS.MouseBehavior=old.mouse;UIS.MouseIconEnabled=old.icon end)
    if S.restoreBackpack then pcall(S.restoreBackpack) end
    Lighting.ClockTime=old.clock;Lighting.Ambient=old.ambient
    Lighting.OutdoorAmbient=old.outdoor;Lighting.Brightness=old.brightness
    Lighting.FogEnd=old.fog;Lighting.FogColor=old.fogColor
    Lighting.ExposureCompensation=old.exposure
    if _G.__GRANNY_SINGLE_FILE__==S then _G.__GRANNY_SINGLE_FILE__=nil end
end
S.stop=stop
local SoundService=game:GetService("SoundService")
