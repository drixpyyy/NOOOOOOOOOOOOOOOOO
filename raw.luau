entry("exploit finder", function()
    local players = game:GetService("Players")
    local function show(text, seconds)
        local message = Instance.new("Message")
        message.Text = text
        message.Parent = workspace
        task.wait(seconds)
        message:Destroy()
    end
    local foundParts = false
    for _, o in game:GetDescendants() do
        local model = o:IsA("Model") and o or o:FindFirstAncestorOfClass("Model")
        if model and players:FindFirstChild(model.Name) then continue end
        if (o:IsA("Part") or o:IsA("MeshPart")) and not o.Anchored then
            print("network ownership:", o:GetFullName())
            foundParts = true
        end
    end
    if foundParts then
        show("ok", 2)
        show("things printed can be manipulated with network ownership", 4.2)
    end
    local ok, respectFiltering = pcall(function()
        return game:GetService("SoundService").RespectFilteringEnabled
    end)
    if ok and respectFiltering == false then
        show("sound spamming is FE", 4.2)
    end
    local detectors = {}
    for _, object in game:GetDescendants() do
        if object:IsA("ClickDetector") then table.insert(detectors, object) end
    end
    if #detectors > 0 then show("double checking", 1.2) end
    local protected, unprotected = false, false
    for _, detector in detectors do
        if detector.Parent and detector.Parent:FindFirstChildOfClass("Script") then
            print("protected cds:", detector:GetFullName())
            protected = true
        else
            print("cds:", detector:GetFullName())
            unprotected = true
        end
    end
    if protected then show("cds printed prob protected", 4.2) end
    if unprotected then show("cds printed prob abusable", 4.2) end
end),
