entry("Softbody Ball(Client)", function()
-- softbody
P=game:GetService("Players")RS=game:GetService("RunService")UIS=game:GetService("UserInputService")AS=game:GetService("AssetService")lp=P.LocalPlayer cam=workspace.CurrentCamera R=2.6 SUB=2 STEPS=6 SKIN=0.035 GRAV=-88 MAXD=95 MAT=Enum.Material.SmoothPlastic TRANS=0.08 REFL=0.1 GLOW=Color3.fromRGB(0,215,255)EC=0.00013 BC=0.00105 SC=0.00175 VC=0.000014 PRES=1 DAMP=2.55 REST=0.58 FRIC=0.18 function cFn(u)local w=0.5+0.5*math.sin(u.Y*2.6+math.atan2(u.Z,u.X)*2)local l=math.clamp((u.Y+1)*0.5,0,1)return Color3.fromHSV((0.5+0.14*(1-l)+0.06*w)%1,math.clamp(0.78-0.18*l,0,1),0.98)end function bI(s)local p=(1+math.sqrt(5))*0.5 local rw={Vector3.new(-1,p,0),Vector3.new(1,p,0),Vector3.new(-1,-p,0),Vector3.new(1,-p,0),Vector3.new(0,-1,p),Vector3.new(0,1,p),Vector3.new(0,-1,-p),Vector3.new(0,1,-p),Vector3.new(p,0,-1),Vector3.new(p,0,1),Vector3.new(-p,0,-1),Vector3.new(-p,0,1)}local vt=table.create(12)for i,v in ipairs(rw)do vt[i]=v.Unit end local fc={{1,12,6},{1,6,2},{1,2,8},{1,8,11},{1,11,12},{2,6,10},{6,12,5},{12,11,3},{11,8,7},{8,2,9},{4,10,5},{4,5,3},{4,3,7},{4,7,9},{4,9,10},{5,10,6},{3,5,12},{7,3,11},{9,7,8},{10,9,2}}for _=1,s do local mc={}local function gM(i,j)local a,b=math.min(i,j),math.max(i,j)local k=a*65536+b if mc[k]then return mc[k]end local x=#vt+1 vt[x]=((vt[i]+vt[j])*0.5).Unit mc[k]=x return x end local nf=table.create(#fc*4)local n=0 for _,t in ipairs(fc)do local a,b,c=t[1],t[2],t[3]local ab,bc,ca=gM(a,b),gM(b,c),gM(c,a)nf[n+1]={a,ab,ca}nf[n+2]={b,bc,ab}nf[n+3]={c,ca,bc}nf[n+4]={ab,bc,ca}n+=4 end fc=nf end local ed,hg,eo={},{},{}for _,t in ipairs(fc)do local a,b,c=t[1],t[2],t[3]for _,tr in ipairs({{a,b,c},{b,c,a},{c,a,b}})do local u,v,op=math.min(tr[1],tr[2]),math.max(tr[1],tr[2]),tr[3]local k=u*65536+v local r=eo[k]if not r then eo[k]={op}ed[#ed+1]={u,v}else r[2]=op hg[#hg+1]={r[1],op}end end end return vt,fc,ed,hg end function gSP()cam=workspace.CurrentCamera if lp and lp.Character then local h=lp.Character:FindFirstChild("HumanoidRootPart")if h then return h.Position+h.CFrame.LookVector*(R*3.8+4)+Vector3.new(0,R*2.2+3.5,0)end end if cam then return cam.CFrame.Position+cam.CFrame.LookVector*14+Vector3.new(0,4,0)end return Vector3.new(0,14,0)end sPos=gSP()oB=workspace:FindFirstChild("SoftJiggleBall")if oB then oB:Destroy()end cnt=Instance.new("Model")cnt.Name="SoftJiggleBall"cnt.Parent=workspace uV,fcs,eP,hP=bI(SUB)nV=#uV nF=#fcs fRU=table.create(nF)for i=1,nF do local t=fcs[i]fRU[i]=(uV[t[1]]+uV[t[2]]+uV[t[3]]).Unit end uEM=false eM=nil mP=nil vId=nil nId=nil cId=nil do local ok=pcall(function()local em=AS:CreateEditableMesh()local vi,ni,ci=table.create(nV),table.create(nV),table.create(nV)for i=1,nV do local u=uV[i]vi[i]=em:AddVertex(u*(R*2.8))ni[i]=em:AddNormal(u)ci[i]=em:AddColor(cFn(u),1)end for i=1,nF do local t=fcs[i]local fid=em:AddTriangle(vi[t[1]],vi[t[2]],vi[t[3]])em:SetFaceNormals(fid,{ni[t[1]],ni[t[2]],ni[t[3]]})em:SetFaceColors(fid,{ci[t[1]],ci[t[2]],ci[t[3]]})end local mp=AS:CreateMeshPartAsync(Content.fromObject(em))for i=1,nV do em:SetPosition(vi[i],uV[i]*R)end mp.Name="JellyMesh"mp.Color=Color3.new(1,1,1)mp.Material=MAT mp.Transparency=TRANS mp.Reflectance=REFL pcall(function()mp.DoubleSided=true end)mp.Anchored=true mp.CanCollide=false mp.CanQuery=false mp.CanTouch=false mp.CastShadow=true mp.CFrame=CFrame.new(sPos)mp.Parent=cnt em:SetNormal(ni[1],uV[1])eM=em mP=mp vId=vi nId=ni cId=ci uEM=true end)if not ok then uEM=false for _,c in ipairs(cnt:GetChildren())do c:Destroy()end end end wP=nil wM=nil wCF=nil if not uEM then wP=table.create(nF*2)wM=table.create(nF*2)wCF=table.create(nF*2)for f=1,nF do local fc=cFn(fRU[f])for s=1,2 do local x=(f-1)*2+s local w=Instance.new("WedgePart")w.Name="Tri"w.Color=fc w.Material=MAT w.Transparency=0 w.Reflectance=REFL w.TopSurface=Enum.SurfaceType.Smooth w.BottomSurface=Enum.SurfaceType.Smooth w.Anchored=true w.CanCollide=false w.CanQuery=false w.CanTouch=false w.CastShadow=true w.Size=Vector3.one w.CFrame=CFrame.new(sPos)local sm=Instance.new("SpecialMesh")sm.MeshType=Enum.MeshType.Wedge sm.Scale=Vector3.new(0,0.5,0.5)sm.Parent=w w.Parent=cnt wP[x]=w wM[x]=sm wCF[x]=w.CFrame end end end hb=Instance.new("Part")hb.Name="BallGrabHitbox"hb.Shape=Enum.PartType.Ball hb.Size=Vector3.one*(R*2.3)hb.Transparency=1 hb.Anchored=true hb.CanCollide=false hb.CanTouch=false hb.CanQuery=true hb.CFrame=CFrame.new(sPos)hb.Parent=cnt pL=Instance.new("PointLight")pL.Color=GLOW pL.Brightness=0.65 pL.Range=R*3.6 pL.Shadows=false pL.Parent=hb hl=Instance.new("Highlight")hl.Adornee=cnt hl.FillTransparency=1 hl.OutlineColor=Color3.fromRGB(255,255,255)hl.OutlineTransparency=1 hl.Parent=cnt cd=Instance.new("ClickDetector")cd.MaxActivationDistance=MAXD cd.Parent=hb rL=table.create(nV)pos=table.create(nV)pPos=table.create(nV)fSP=table.create(nV)vel=table.create(nV)pVel=table.create(nV)vG=table.create(nV)hN=table.create(nV)hSV=table.create(nV)for i=1,nV do local rl=uV[i]*R rL[i]=rl local wp=sPos+rl pos[i]=wp pPos[i]=wp fSP[i]=wp vel[i]=Vector3.zero pVel[i]=Vector3.zero vG[i]=Vector3.zero end eU=table.create(#eP)eV=table.create(#eP)eL=table.create(#eP)for i,e in ipairs(eP)do eU[i]=e[1]eV[i]=e[2]eL[i]=(rL[e[1]]-rL[e[2]]).Magnitude end bU=table.create(#hP)bV=table.create(#hP)bL=table.create(#hP)for i,h in ipairs(hP)do bU[i]=h[1]bV[i]=h[2]bL[i]=(rL[h[1]]-rL[h[2]]).Magnitude end fA=table.create(nF)fB=table.create(nF)fC=table.create(nF)for i,t in ipairs(fcs)do fA[i]=t[1]fB[i]=t[2]fC[i]=t[3]end function cVG(pts,ctr)for i=1,nV do vG[i]=Vector3.zero end local v6=0 for i=1,nF do local ia,ib,ic=fA[i],fB[i],fC[i]local a,b,c=pts[ia]-ctr,pts[ib]-ctr,pts[ic]-ctr local g=(b-a):Cross(c-a)*(1/6)vG[ia]+=g vG[ib]+=g vG[ic]+=g v6+=a:Cross(b):Dot(c)end return v6/6 end bRV=math.max(1e-3,cVG(rL,Vector3.zero))rRot=CFrame.identity iRef=0 for i=1,nV do iRef+=rL[i]:Dot(rL[i])end function gC()local s=Vector3.zero for i=1,nV do s+=pos[i]end return s/nV end function rBA(tc)rRot=CFrame.identity for i=1,nV do local wp=tc+rL[i]pos[i]=wp pPos[i]=wp fSP[i]=wp vel[i]=uV[i]*4 end end held=false hov=false hDist=13 hClk=0 gW=table.create(nV,0)sGT=sPos gTV=Vector3.zero function bG()cam=workspace.CurrentCamera local ctr=gC()held=true hClk=os.clock()sGT=ctr gTV=Vector3.zero local pWD=Vector3.yAxis if cam then local d=(ctr-cam.CFrame.Position).Magnitude hDist=math.clamp(d,R*2.2+2,42)local mL=UIS:GetMouseLocation()local mR=cam:ViewportPointToRay(mL.X,mL.Y)local oc=mR.Origin-ctr local b=oc:Dot(mR.Direction)local cT=oc:Dot(oc)-R*R local dc=b*b-cT if dc>=0 then local tH=-b-math.sqrt(dc)if tH>0 then pWD=((mR.Origin+mR.Direction*tH)-ctr).Unit end else pWD=(Vector3.yAxis*0.72-mR.Direction*0.28).Unit end end local gLD=rRot:VectorToObjectSpace(pWD)for i=1,nV do local al=uV[i]:Dot(gLD)gW[i]=0.14+0.86*math.exp(-1.65*(1-al))end hl.OutlineColor=Color3.fromRGB(255,255,255)hl.OutlineTransparency=0.2 end function rG()if not held then return end held=false local bst=gTV*0.24 if bst.Magnitude>60 then bst=bst.Unit*60 end for i=1,nV do vel[i]+=bst end hl.OutlineTransparency=hov and 0.55 or 1 end cd.MouseHoverEnter:Connect(function()hov=true if not held then hl.OutlineTransparency=0.55 end end)cd.MouseHoverLeave:Connect(function()hov=false if not held then hl.OutlineTransparency=1 end end)cd.MouseClick:Connect(function(plr)if plr and plr~=lp then return end if not held then bG()elseif os.clock()-hClk>0.18 then rG()end end)cns={}cns[#cns+1]=UIS.InputBegan:Connect(function(inp,gp)if inp.UserInputType==Enum.UserInputType.MouseButton1 then if held and os.clock()-hClk>0.18 then rG()elseif not gp and hov and not held then bG()end elseif not gp and inp.KeyCode==Enum.KeyCode.R then held=false rBA(gSP())end end)cns[#cns+1]=UIS.InputEnded:Connect(function(inp)if inp.UserInputType==Enum.UserInputType.MouseButton1 then if held and os.clock()-hClk>0.24 then rG()end end end)cns[#cns+1]=UIS.InputChanged:Connect(function(inp,gp)if held and not gp and inp.UserInputType==Enum.UserInputType.MouseWheel then hDist=math.clamp(hDist+inp.Position.Z*2.4,R*2+2,70)end end)ovP=OverlapParams.new()ovP.FilterType=Enum.RaycastFilterType.Exclude ovP.FilterDescendantsInstances={cnt}ryP=RaycastParams.new()ryP.FilterType=Enum.RaycastFilterType.Exclude ryP.FilterDescendantsInstances={cnt}ryP.RespectCanCollide=true ryP.IgnoreWater=true tpP=RaycastParams.new()tpP.FilterType=Enum.RaycastFilterType.Include tpP.FilterDescendantsInstances={workspace.Terrain}tpP.IgnoreWater=true cols={}hCC=false pDr={Vector3.new(0,-1,0),Vector3.new(0,1,0),Vector3.new(1,0,0),Vector3.new(-1,0,0),Vector3.new(0,0,1),Vector3.new(0,0,-1)}function gCol(ctr,rB)table.clear(cols)hCC=false local pts=workspace:GetPartBoundsInRadius(ctr,rB,ovP)for _,p in ipairs(pts)do if not p.CanCollide then local pm=p.Parent local iv=(p.Transparency<0.9)and(p.Name~="HumanoidRootPart")and(pm~=nil and pm:FindFirstChildOfClass("Humanoid")~=nil)if not iv then continue end end local cf,sz,lv,av=p.CFrame,p.Size,p.AssemblyLinearVelocity,p.AssemblyAngularVelocity local pp=cf.Position if p:IsA("WedgePart")then local hx,hy,hz=sz.X*0.5,sz.Y*0.5,sz.Z*0.5 local sl=math.sqrt(hy*hy+hz*hz)if sl>1e-4 then cols[#cols+1]={k=4,cf=cf,pp=pp,hx=hx,hy=hy,hz=hz,sl=sl,sk=SKIN,lv=lv,av=av}end elseif p:IsA("Part")then local sp=p.Shape if sp==Enum.PartType.Ball then cols[#cols+1]={k=2,pp=pp,rd=math.min(sz.X,sz.Y,sz.Z)*0.5+SKIN,lv=lv,av=av}elseif sp==Enum.PartType.Cylinder then cols[#cols+1]={k=3,cf=cf,pp=pp,hx=sz.X*0.5+SKIN,rd=math.min(sz.Y,sz.Z)*0.5+SKIN,lv=lv,av=av}else cols[#cols+1]={k=1,cf=cf,pp=pp,hx=sz.X*0.5+SKIN,hy=sz.Y*0.5+SKIN,hz=sz.Z*0.5+SKIN,lv=lv,av=av}end else hCC=true end end if not hCC and workspace.Terrain then for i=1,6 do if workspace:Raycast(ctr,pDr[i]*rB,tpP)then hCC=true break end end end end function pPOC(pt)local ps,lN,lV=pt,nil,Vector3.zero for i=1,#cols do local c=cols[i]local k=c.k if k==1 then local lpt=c.cf:PointToObjectSpace(ps)local ax,ay,az=math.abs(lpt.X),math.abs(lpt.Y),math.abs(lpt.Z)local hx,hy,hz=c.hx,c.hy,c.hz if ax<hx and ay<hy and az<hz then local dx,dy,dz=hx-ax,hy-ay,hz-az local ln if dy<=dx and dy<=dz then local sy=lpt.Y>=0 and 1 or -1 lpt=Vector3.new(lpt.X,sy*hy,lpt.Z)ln=Vector3.new(0,sy,0)elseif dx<=dz then local sx=lpt.X>=0 and 1 or -1 lpt=Vector3.new(sx*hx,lpt.Y,lpt.Z)ln=Vector3.new(sx,0,0)else local sz=lpt.Z>=0 and 1 or -1 lpt=Vector3.new(lpt.X,lpt.Y,sz*hz)ln=Vector3.new(0,0,sz)end ps=c.cf:PointToWorldSpace(lpt)lN=c.cf:VectorToWorldSpace(ln)lV=c.lv+c.av:Cross(ps-c.pp)end elseif k==2 then local df=ps-c.pp local d=df.Magnitude if d<c.rd then local wn=d>1e-5 and(df/d)or Vector3.yAxis ps=c.pp+wn*c.rd lN=wn lV=c.lv+c.av:Cross(ps-c.pp)end elseif k==3 then local lpt=c.cf:PointToObjectSpace(ps)local ax=math.abs(lpt.X)local r2=math.sqrt(lpt.Y*lpt.Y+lpt.Z*lpt.Z)if ax<c.hx and r2<c.rd then local dx,dr=c.hx-ax,c.rd-r2 local ln if dx<dr then local sx=lpt.X>=0 and 1 or -1 lpt=Vector3.new(sx*c.hx,lpt.Y,lpt.Z)ln=Vector3.new(sx,0,0)else local ny=r2>1e-5 and(lpt.Y/r2)or 1 local nz=r2>1e-5 and(lpt.Z/r2)or 0 lpt=Vector3.new(lpt.X,ny*c.rd,nz*c.rd)ln=Vector3.new(0,ny,nz)end ps=c.cf:PointToWorldSpace(lpt)lN=c.cf:VectorToWorldSpace(ln)lV=c.lv+c.av:Cross(ps-c.pp)end elseif k==4 then local lpt=c.cf:PointToObjectSpace(ps)local hx,hy,hz,sk,sl=c.hx,c.hy,c.hz,c.sk,c.sl local ax=math.abs(lpt.X)local sd=(lpt.Y*hz-lpt.Z*hy)/sl if ax<hx+sk and lpt.Y>-hy-sk and lpt.Z<hz+sk and sd<sk then local pX,pBo,pBa,pSl=(hx+sk)-ax,lpt.Y+hy+sk,(hz+sk)-lpt.Z,sk-sd local m=math.min(pX,pBo,pBa,pSl)local ln if m==pSl then local ny,nz=hz/sl,-hy/sl lpt=Vector3.new(lpt.X,lpt.Y+ny*pSl,lpt.Z+nz*pSl)ln=Vector3.new(0,ny,nz)elseif m==pBo then lpt=Vector3.new(lpt.X,-hy-sk,lpt.Z)ln=Vector3.new(0,-1,0)elseif m==pBa then lpt=Vector3.new(lpt.X,lpt.Y,hz+sk)ln=Vector3.new(0,0,1)else local sx=lpt.X>=0 and 1 or -1 lpt=Vector3.new(sx*(hx+sk),lpt.Y,lpt.Z)ln=Vector3.new(sx,0,0)end ps=c.cf:PointToWorldSpace(lpt)lN=c.cf:VectorToWorldSpace(ln)lV=c.lv+c.av:Cross(ps-c.pp)end end end return ps,lN,lV end function uFT(fi,a,b,c)local tc=(a+b+c)*(1/3)local da,db,dc=a-tc,b-tc,c-tc local ma,mb,mc=da.Magnitude,db.Magnitude,dc.Magnitude if ma>1e-5 and mb>1e-5 an