local function playSfx(key,localPos,volume)
    local id=SOUND_IDS[key]
    if not id or id=="" then
        if playSynth then playSynth(key,localPos,volume) end
        return
    end
    local source=SoundService
    if localPos then
        local emitter=Instance.new("Part")
        emitter.Name="Granny local sound • "..key
        emitter.Size=Vector3.new(.1,.1,.1);emitter.Transparency=1
        emitter.Anchored=true;emitter.CanCollide=false;emitter.CanQuery=false
        emitter.CanTouch=false;emitter.Position=S.origin+localPos;emitter.Parent=model
        source=emitter;Debris:AddItem(emitter,12)
    end
    local sound=Instance.new("Sound")
    sound.Name=key;sound.SoundId="rbxassetid://"..tostring(id):gsub("rbxassetid://","")
    sound.Volume=volume or .55
    sound.RollOffMaxDistance=35;sound.RollOffMinDistance=3
    sound.Parent=source;sound:Play()
    if source==SoundService then Debris:AddItem(sound,12) end
end
