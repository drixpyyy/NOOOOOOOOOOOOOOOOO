local function __decodeBase64(data)
	local native = (crypt and crypt.base64decode)
		or (base64 and base64.decode)
		or base64_decode
		or base64decode
		or (syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode)
	if type(native) == "function" then
		local ok, res = pcall(native, data)
		if ok and type(res) == "string" and #res > 0 then
			return res
		end
	end

	local lut = table.create and table.create(256, -1) or {}
	for i = 0, 255 do
		lut[i] = -1
	end
	local alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do
		lut[string.byte(alpha, i)] = i - 1
	end

	local clean = string.gsub(data, "[^A-Za-z0-9+/=]", "")
	local len = #clean
	local out = table.create and table.create(math.ceil(len * 3 / 4)) or {}
	local idx = 1
	for i = 1, len, 4 do
		local a = lut[string.byte(clean, i)]
		local b = lut[string.byte(clean, i + 1)]
		local cByte = string.byte(clean, i + 2)
		local dByte = string.byte(clean, i + 3)
		local c = (cByte == 61) and 0 or lut[cByte]
		local d = (dByte == 61) and 0 or lut[dByte]

		local n = bit32.lshift(a, 18) + bit32.lshift(b, 12) + bit32.lshift(c, 6) + d
		local b1 = bit32.rshift(n, 16)
		local b2 = bit32.band(bit32.rshift(n, 8), 0xFF)
		local b3 = bit32.band(n, 0xFF)

		if cByte == 61 then
			out[idx] = string.char(b1)
		elseif dByte == 61 then
			out[idx] = string.char(b1, b2)
		else
			out[idx] = string.char(b1, b2, b3)
		end
		idx = idx + 1
	end
	return table.concat(out)
end

local __AUDIO_B64 = {
	["138507651"] = { ext = "ogg", b64 = [[]] },
	["299058146"] = { ext = "ogg", b64 = [[]] },
	["382823862"] = { ext = "ogg", b64 = [[]] },
	["382823907"] = { ext = "ogg", b64 = [[]] },
	["851453784"] = { ext = "ogg", b64 = [[]] },
}

local __AUDIO_CACHE = {}
local __TEMP_AUDIO_FILES = {}

local function __resolveSoundId(rawId)
	local str = tostring(rawId or "")
	local numId = string.match(str, "(%d+)")
	if numId and __AUDIO_B64[numId] then
		if __AUDIO_CACHE[numId] then
			return __AUDIO_CACHE[numId]
		end
		local getAsset = getcustomasset or getsynasset
		if type(writefile) == "function" and type(getAsset) == "function" then
			local entry = __AUDIO_B64[numId]
			local audioFile = "__rbxm_audio_" .. numId .. "." .. entry.ext
			local okAudio, customUrl = pcall(function()
				local rawBytes = __decodeBase64(entry.b64)
				writefile(audioFile, rawBytes)
				return getAsset(audioFile)
			end)
			if okAudio and type(customUrl) == "string" and #customUrl > 0 then
				__AUDIO_CACHE[numId] = customUrl
				table.insert(__TEMP_AUDIO_FILES, audioFile)
				return customUrl
			end
		end
	end
	if numId then
		return "rbxassetid://" .. numId
	end
	return str
end

local function __cleanupAudioTempFiles()
	if type(delfile) == "function" then
		for _, path in ipairs(__TEMP_AUDIO_FILES) do
			pcall(delfile, path)
		end
	end
end

local function __loadEffectPack()
	local b64 = [[]]
	local getAsset = getcustomasset or getsynasset
	local pack = nil
	local okPack = false

	if type(writefile) == "function" and type(getAsset) == "function" then
		local tempFile = "__rbxm_extras_" .. tostring(math.floor(os.clock() * 1000)) .. "_" .. tostring(math.random(1000, 9999)) .. ".rbxm"
		local okLoad, result = pcall(function()
			local raw = __decodeBase64(b64)
			writefile(tempFile, raw)
			local objs = game:GetObjects(getAsset(tempFile))
			return objs and objs[1]
		end)
		if type(delfile) == "function" then
			task.delay(2, function()
				pcall(delfile, tempFile)
			end)
		end
		if okLoad and result then
			pack = result:Clone()
			okPack = true
		end
	end
	if not okPack then
		local okAsset, assetObjs = pcall(function()
			return game:GetObjects("rbxassetid://5724295147")
		end)
		if okAsset and assetObjs and assetObjs[1] then
			local rootObj = assetObjs[1]
			local testObj = rootObj:FindFirstChild("Test")
			local foundExtras = (testObj and testObj:FindFirstChild("Extras")) or rootObj:FindFirstChild("Extras") or rootObj
			if foundExtras then
				pack = foundExtras:Clone()
				okPack = true
			end
		end
	end
	if not okPack or not pack then
		error("[RBXM Executor Converter] Failed to load model assets: executor needs writefile + getcustomasset/getsynasset + game:GetObjects.", 2)
	end

	for _, desc in ipairs(pack:GetDescendants()) do
		if desc:IsA("Sound") and desc.SoundId ~= "" then
			desc.SoundId = __resolveSoundId(desc.SoundId)
		end
	end

	return pack
end

