function ForcePlayFind(v, tablex, once)
	if once then
		local onceAudios = {}
		for x,y in pairs(v.Character:GetChildren()) do
			if y:IsA("Tool") then
				for c,m in pairs(y:GetDescendants()) do
					if m:IsA("Sound") then
						m.Playing = true
					end
				end
			end
		end
		for x,y in pairs(v.Backpack:GetDescendants()) do
			if y:IsA("Sound") then
				y.Playing = true
			end
		end
		return
	end
	pcall(function()
		for x,y in pairs(v.Character:GetChildren()) do
			if y:IsA("Tool") then
				for c,m in pairs(y:GetDescendants()) do
					if m:IsA("Sound") then
