-- Determine safe map offset so host game geometry never overlaps Facility corridors
local MAP_OFFSET = Vector3.zero
do
    local chars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            chars[p.Character] = true
        end
    end
    local overlapFound = false
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") and inst.ClassName ~= "Terrain" then
            local inChar = false
            local cur = inst.Parent
            while cur do
                if chars[cur] then
                    inChar = true
                    break
                end
                cur = cur.Parent
            end
            if not inChar then
                local pos = inst.Position
                local topY = pos.Y + inst.Size.Y * 0.5
                local isSpawn = inst:IsA("SpawnLocation")
                local inCoreXZ = pos.X >= -195 and pos.X <= 140 and pos.Z >= -200 and pos.Z <= 345
                if (inCoreXZ and topY > 0.15) or (isSpawn and inCoreXZ) then
                    overlapFound = true
                    break
                end
            end
        end
    end
    if overlapFound then
        MAP_OFFSET = Vector3.new(0, 600, 0)
    end
end

