local function __boot(role, chunkFn)
	local world = __makeWorld(role)
	__worlds[role] = world
	world.env.script = __bundleScript
	local co = coroutine.create(function()
		return chunkFn(world.env, world.req)
	end)
	coroutine.resume(co)
	return co
end

