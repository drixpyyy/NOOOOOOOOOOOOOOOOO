if RunService:IsServer() and not LocalPlayer then
	__boot("server", serverChunk)
elseif LocalPlayer then
	if CONFIG.AUTORUN_SERVER then
		__boot("server", serverChunk)
	end
	__boot("client", clientChunk)
end
--incase rbxassets get deleted

local backup = {
	[413422291] = "",
	[11293977610] = "",
	[11293978505] = "",
	[11295273292] = "",
	[11419703033] = "",
	[11422141395] = "",
	[11422154787] = "",
	[11432832657] = "",
	[11432850205] = "",
	[11433532654] = "",
	[12974204015] = "",
	[13960012399] = "",
}

local localAssets = {}

if writefile and getcustomasset then
	local folder = "sensationhub"
	if isfolder and not isfolder(folder) then
		makefolder(folder)
	end

	local function decode(data)
		local out = buffer.create(#data * 3 // 4)
		local size, acc, bits = 0, 0, 0
		for i = 1, #data do
			local byte = string.byte(data, i)
			local value
			if byte >= 65 and byte <= 90 then
				value = byte - 65
			elseif byte >= 97 and byte <= 122 then
				value = byte - 71
			elseif byte >= 48 and byte <= 57 then
				value = byte + 4
			elseif byte == 43 then
				value = 62
			elseif byte == 47 then
				value = 63
			end
			if value then
				acc = acc * 64 + value
				bits += 6
				if bits >= 8 then
					bits -= 8
					local scale = 2 ^ bits
					buffer.writeu8(out, size, math.floor(acc / scale) % 256)
					size += 1
					acc = acc % scale
				end
			end
		end
		local exact = buffer.create(size)
		buffer.copy(exact, 0, out, 0, size)
		return buffer.tostring(exact)
	end

	for id, data in pairs(backup) do
		local path = folder .. "/" .. id .. ".png"
		local ok = pcall(writefile, path, decode(data))
		if ok then
			local okUrl, url = pcall(getcustomasset, path)
			if okUrl then
				localAssets[id] = url
			end
		end
	end
end

local function restoreAssets()
	local player = LocalPlayer
	local gui = player and player:FindFirstChildOfClass("PlayerGui")
	if not gui then
		return
	end
	for _, object in ipairs(gui:GetDescendants()) do
		for _, property in ipairs({ "Image", "Texture" }) do
			local ok, value = pcall(function()
				return object[property]
			end)
			local id = ok and type(value) == "string" and tonumber(string.match(value, "rbxassetid://(%d+)"))
			local url = id and localAssets[id]
			if url then
				local loaded = false
				pcall(function()
					loaded = object.IsLoaded
				end)
				if not loaded then
					pcall(function()
						object[property] = url
					end)
				end
			end
		end
	end
end

task.spawn(function()
	task.wait(6)
	restoreAssets()
	for _ = 1, 4 do
		task.wait(6)
		restoreAssets()
	end
end)
