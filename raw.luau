		local ps = Player:FindFirstChild("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		local cm = pm and pm:FindFirstChild("ControlModule")
		if cm then
			ctrlModule = require(cm)
		end
	end)

	local function getMoveVector()
		local vec = Vector3.new(0, 0, 0)
		if ctrlModule and type(ctrlModule.GetMoveVector) == "function" then
			local ok, v = pcall(ctrlModule.GetMoveVector, ctrlModule)
			if ok and typeof(v) == "Vector3" then
				vec = v
			end
		end
		if vec.Magnitude < 0.01 and not UserInputService:GetFocusedTextBox() then
			local x, z = 0, 0
			if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
				z = z - 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
				z = z + 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
				x = x - 1
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
				x = x + 1
			end
			vec = Vector3.new(x, 0, z)
		end
		return vec
	end

	track(UserInputService.JumpRequest:Connect(function()
		if Humanoid and Humanoid.Parent and Humanoid.Health > 0 then
			Humanoid.Jump = true
		end
	end))

