local function updateObjects(dt)
    for _,g in ipairs(groups) do
        if g.kind==0 then
            local oldAngle=g.angle
            g.angle+=clamp(g.target-g.angle,-dt*2.5,dt*2.5)
            if math.abs(g.angle-oldAngle)>.0001 then applyGroup(g) end
        elseif g.kind==3 then
            local oldSlide=g.slide
            g.slide+=clamp(g.target-g.slide,-dt*2,dt*2)
            if math.abs(g.slide-oldSlide)>.0001 then applyGroup(g) end
        elseif g==heldItem then
            if S.toolFallback then
                local cam=workspace.CurrentCamera
                g.pos=cam.CFrame.Position-ORIGIN+cam.CFrame.LookVector*1.55
                    -cam.CFrame.UpVector*.52+cam.CFrame.RightVector*.42
                applyGroup(g)
            end
        elseif g.attachmentDoor and not g.dynamic and not g.hidden then
            local door=g.attachmentDoor
            local newPos=door.pivot+CFrame.Angles(0,door.angle or 0,0)
                :VectorToWorldSpace(g.center-door.pivot)
            if (newPos-g.pos).Magnitude>.002 then g.pos=newPos;applyGroup(g) end
        elseif g.container and not g.dynamic and not g.hidden then
            if g.container.slideVector then
                local newPos=g.center+g.container.slideVector*g.container.slide
                if (newPos-g.pos).Magnitude>.002 then g.pos=newPos;applyGroup(g) end
            end
        elseif (g.kind==1 or g.kind==4 or g.kind==6 or g.kind==7)
            and g.dynamic and not g.hidden then
            local v=g.velocity+Vector3.new(0,-35*dt,0)
            local pos=g.pos+v*dt
            local foot=Vector3.new(pos.X,pos.Y-g.halfHeight,pos.Z)
            local blocked=wallPush(foot,g.radius,math.max(.4,2*g.halfHeight))
            pos=Vector3.new(blocked.X,pos.Y,blocked.Z)
            local floor=floorAt(Vector3.new(pos.X,pos.Y-g.halfHeight,pos.Z),.8,2.4,true)
            if floor>-1e5 and pos.Y-g.halfHeight<floor then
                if not g.soundAt and v.Y < -2.2 then
                    g.soundAt=os.clock()
                    playSfx(g.dropSound or (g.kind==6 and "fall_padlock"
                        or g.kind==7 and "fall_padlock" or "fall_wood"),g.pos,.8)
                    makeNoise(g.pos,g.dropSound=="fall_metal" and 33 or 19)
                end
