local function staticPart(m,idx)
    local em=AS:CreateEditableMesh()
    assert(em,"EditableMesh quota reached for house batch "..idx)
    local ids=table.create(m.nv);local uvs=table.create(m.nv)
    for i=0,m.nv-1 do
        local pos=m.start+i*6
        local uv=m.start+m.nv*6+i*4
        local x=buffer.readu16(raw,pos)/65535*m.span.X-m.span.X*.5
        local y=buffer.readu16(raw,pos+2)/65535*m.span.Y-m.span.Y*.5
        local z=buffer.readu16(raw,pos+4)/65535*m.span.Z-m.span.Z*.5
        ids[i+1]=em:AddVertex(Vector3.new(x,y,z))
        uvs[i+1]=em:AddUV(Vector2.new(buffer.readu16(raw,uv)/65535,buffer.readu16(raw,uv+2)/65535))
        if i%3200==0 then task.wait() end
