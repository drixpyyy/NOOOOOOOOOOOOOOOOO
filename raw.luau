                                    local point=Vector3.new(start.X,0,start.Z)
                                        +edge*clamp(rel:Dot(edge)/den,0,1)
                                    local diff=Vector3.new(out.X-point.X,0,out.Z-point.Z)
                                    local d=diff.Magnitude
