local rootModel = res(Instance.new("Model"))
rootModel.Name = "Facility_Converted"
local folders = {}
for _, name in ipairs({
    "Architecture",
    "Lights",
    "Vents",
    "Doors",
    "Pads",
    "Seats",
    "Signs",
    "Props",
    "Spawns",
    "SpawnedShapes",
    "Ambience",
}) do
    local f = Instance.new("Folder")
    f.Name = name
    f.Parent = rootModel
    folders[name] = f
end

local builtParts = {}
local doorIndexSet = {}
for _, idx in ipairs(MAP_DATA.doorIndices) do doorIndexSet[idx] = true end
local padIndexSet = {}
for _, idx in ipairs(MAP_DATA.padIndices) do padIndexSet[idx] = true end
local chuteIndexSet = {}
for _, idx in ipairs(MAP_DATA.chuteIndices) do chuteIndexSet[idx] = true end
local seatIndexSet = {}
for _, idx in ipairs(MAP_DATA.seatIndices) do seatIndexSet[idx] = true end

local lightPartSet = {}
for _, l in ipairs(MAP_DATA.lights) do lightPartSet[l[1]] = true end

local rots = MAP_DATA.rotations
local cols = MAP_DATA.colors
local mats = MAP_DATA.materials

local enumMatCache = {}
for i, mName in ipairs(mats) do
    enumMatCache[i] = Enum.Material[mName] or Enum.Material.Plastic
end
local colorCache = {}
for i, c in ipairs(cols) do
    colorCache[i] = Color3.fromRGB(c[1], c[2], c[3])
end

local surfaceProps = { "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" }

local function buildParts()
    for idx, entry in ipairs(MAP_DATA.parts) do
        local cCode = entry[1]
        local inst
        if cCode == 5 then
            inst = Instance.new("CornerWedgePart")
        elseif cCode == 6 then
            inst = Instance.new("WedgePart")
        elseif cCode == 7 then
            inst = Instance.new("Seat")
            inst.Disabled = false
        elseif cCode == 8 then
            inst = Instance.new("SpawnLocation")
            inst.Enabled = false
        else
            inst = Instance.new("Part")
            if cCode == 2 then
                inst.Shape = Enum.PartType.Ball
            elseif cCode == 3 then
                inst.Shape = Enum.PartType.Cylinder
            elseif cCode == 4 then
                inst.Shape = Enum.PartType.Wedge
            else
                inst.Shape = Enum.PartType.Block
            end
        end

        local r = rots[entry[5]]
        inst.CFrame = CFrame.new(
            entry[2] + MAP_OFFSET.X,
            entry[3] + MAP_OFFSET.Y,
            entry[4] + MAP_OFFSET.Z,
            r[1], r[2], r[3],
            r[4], r[5], r[6],
            r[7], r[8], r[9]
        )
        inst.Size = Vector3.new(entry[6], entry[7], entry[8])
        inst.Color = colorCache[entry[9]]
        inst.Material = enumMatCache[entry[10]]
        inst.Transparency = entry[11]
        inst.CanCollide = entry[12] == 1
        inst.CastShadow = entry[13] == 1
        inst.Anchored = true

        local surfFlag = entry[14]
        local surfEnum = Enum.SurfaceType.SmoothNoOutlines
        if surfFlag == 1 then
            surfEnum = Enum.SurfaceType.Smooth
        elseif surfFlag == 2 then
            surfEnum = Enum.SurfaceType.Weld
        end
        for _, sp in ipairs(surfaceProps) do
            inst[sp] = surfEnum
        end

        if doorIndexSet[idx] then
            inst.Name = "FacilityDoor"
            inst.Parent = folders.Doors
        elseif padIndexSet[idx] or chuteIndexSet[idx] then
            inst.Name = padIndexSet[idx] and "ColorPad" or "TurretChute"
            inst.Parent = folders.Pads
        elseif lightPartSet[idx] then
            inst.Name = "CeilingLight"
            inst.Parent = folders.Lights
        elseif seatIndexSet[idx] then
            inst.Name = "OfficeSeat"
            inst.Parent = folders.Seats
        elseif idx == MAP_DATA.spawnPartIdx then
            inst.Name = "FacilitySpawn"
            inst.Parent = folders.Spawns
        elseif entry[6] > 500 or entry[6] < 3.5 then
            inst.Parent = folders.Props
        else
            inst.Parent = folders.Architecture
        end

        builtParts[idx] = inst
    end
end

buildParts()

-- Attach BlockMeshes, Decals, Textures, Signs, PointLights, Sounds
for _, bm in ipairs(MAP_DATA.blockMeshes) do
    local p = builtParts[bm[1]]
    if p then
        local m = Instance.new("BlockMesh")
        m.Scale = Vector3.new(bm[2], bm[3], bm[4])
        m.Offset = Vector3.new(bm[5], bm[6], bm[7])
        m.Parent = p
    end
end

for _, dc in ipairs(MAP_DATA.decals) do
    local p = builtParts[dc[1]]
    if p then
        local inst
        if dc[2] == 1 then
            inst = Instance.new("Texture")
            inst.StudsPerTileU = dc[9]
            inst.StudsPerTileV = dc[10]
            inst.OffsetStudsU = dc[11]
            inst.OffsetStudsV = dc[12]
        else
            inst = Instance.new("Decal")
        end
        local id = dc[3]
        inst.Texture = "rbxassetid://" .. id
