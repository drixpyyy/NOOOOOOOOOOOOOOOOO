		if OldCharacter and OldCharacter.Parent then
			for _, saved in ipairs(__savedOldState.Parts) do
				if saved.Part and saved.Part.Parent then
					saved.Part.CanCollide = saved.CanCollide
					saved.Part.LocalTransparencyModifier = saved.LocalTransparencyModifier
