			end
		end
		if Character and Character.Parent then
			task.delay(3, function()
				if Character and Character.Parent then
					Character:Destroy()
				end
			end)
		end
	end

	if Humanoid then
		track(Humanoid.Died:Connect(cleanup))
	end
	track(Character.AncestryChanged:Connect(function(_, parent)
