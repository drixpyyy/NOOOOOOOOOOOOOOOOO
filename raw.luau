    Lighting.ColorShift_Top = Color3.new(0, 0, 0)
    Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
    pcall(function() Lighting.Outlines = true end)
    pcall(function() Lighting.Technology = Enum.Technology.ShadowMap end)
    pcall(function() Lighting.LightingStyle = Enum.LightingStyle.Soft end)

    local sky = res(Instance.new("Sky"))
    sky.Name = "FacilitySky"
    sky.StarCount = 0
    sky.CelestialBodiesShown = false
    sky.SunAngularSize = 21
    sky.MoonAngularSize = 11
    local skyUri = "http://www.roblox.com/asset/?ID=1361097"
    for _, faceProp in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
        sky[faceProp] = skyUri
        table.insert(trackedAssets, { obj = sky, prop = faceProp, id = "1361097" })
    end
    sky.Parent = Lighting

    local bloom = res(Instance.new("BloomEffect"))
    bloom.Name = "FacilityBloom"
    bloom.Threshold = 0.95
    bloom.Intensity = 0
    bloom.Size = 24
    bloom.Enabled = true
    bloom.Parent = Lighting

    local cgOk, cg = pcall(function() return Instance.new("ColorGradingEffect") end)
    if cgOk and cg then
        cg.Name = "FacilityColorGrading"
        pcall(function() cg.TonemapperPreset = Enum.TonemapperPreset.Retro end)
        cg.Enabled = true
        cg.Parent = Lighting
        res(cg)
    end
end

