-- SYSTEM 3: AMBIENT POWER OUTAGE & RESTORATION CYCLE
-- =====================================================================
local statusLabel -- forward ref for minimal HUD

local function setLightsState(isOn, subsetFilter)
    for idx, rec in ipairs(ceilingLights) do
        if not subsetFilter or subsetFilter(idx, rec) then
            if rec.part and rec.part.Parent then
                if isOn then
                    rec.part.Material = rec.origMat
                    rec.part.Color = rec.origColor
                    rec.light.Enabled = true
                    rec.light.Brightness = rec.origBright
                else
                    rec.part.Material = Enum.Material.SmoothPlastic
                    rec.part.Color = Color3.fromRGB(68, 70, 76)
                    rec.light.Enabled = false
                end
            end
        end
    end
    for _, h in ipairs(humSounds) do
        if h.sound and h.sound.Parent then
            if not subsetFilter or not h.lightRec or h.lightRec.light.Enabled == isOn then
                if isOn then
                    h.sound.Volume = h.origVol
                    if not h.sound.IsPlaying then
                        pcall(function() h.sound:Play() end)
                    end
                else
                    pcall(function() h.sound:Stop() end)
                end
            end
        end
    end
    if not subsetFilter then
        for _, scr in ipairs(crtScreens) do
            if scr.part and scr.part.Parent then
                if isOn then
                    scr.part.Material = Enum.Material.Neon
                    scr.part.Color = scr.origColor
                else
                    scr.part.Material = Enum.Material.SmoothPlastic
                    scr.part.Color = Color3.fromRGB(24, 27, 32)
                end
            end
        end
    end
end

local function updateHudStatus()
    if statusLabel and statusLabel.Parent then
        statusLabel.Text = S.powerOn and "POWER: ONLINE" or "POWER: OUTAGE"
        statusLabel.TextColor3 = S.powerOn and Color3.fromRGB(190, 240, 195) or Color3.fromRGB(255, 115, 115)
    end
end

local function stopOutageAudio()
    for _, id in ipairs({ "9113085665", "2893921424", "1841798430" }) do
        local snd = wsSounds[id]
        if snd and snd.Parent then
            pcall(function() snd:Stop() end)
