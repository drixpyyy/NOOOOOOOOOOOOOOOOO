local function readSpectral()
    local abc="!#$%&()*+,./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ^_abcdefghijklmnopqrstuvwxyz{|"
    local lut=table.create(128,0)
    for i=1,#abc do lut[string.byte(abc,i)]=i-1 end
    local output=buffer.create(math.floor(#spectralEncoded/5)*4)
    local at,k,value=0,0,0
    for i=1,#spectralEncoded do
        local c=string.byte(spectralEncoded,i)
        if c>32 then
            value+=(lut[c] or 0)*85^k;k+=1
            if k==5 then buffer.writeu32(output,at,value);at+=4;value=0;k=0 end
        end
    end
    spectralEncoded=nil
    if buffer.readstring(output,0,4)~="GAS1" then return nil,nil,nil end
    local rate=buffer.readu8(output,4)
    local voices=buffer.readu8(output,5)
    local count=buffer.readu8(output,6)
    local clips={};local offset=7
    for _=1,count do
        local size=buffer.readu8(output,offset);offset+=1
        local name=buffer.readstring(output,offset,size);offset+=size
        local frames=buffer.readu16(output,offset);offset+=2
        clips[name]={at=offset,frames=frames}
        offset+=frames*voices*3
    end
    return output,clips,rate
end
-- Keep sound-clip metadata separate from the imported FBX `clips` table.
-- Shadowing it made Granny's idle/Walk vertex update index audio clips instead.
local spectrum,audioClips,audioRate=readSpectral()
local sineBanks=nil
local function buildSineBanks()
    if sineBanks or not spectrum then return end
    local created={}
    local ok=pcall(function()
        local output=Instance.new("AudioDeviceOutput")
        output.Name="Granny bounded spectral output";output.Parent=SoundService
        created[#created+1]=output
        sineBanks={}
        for bank=1,2 do
            local voices={}
            for i=1,8 do
                local playerWave=Instance.new("AudioPlayer")
                playerWave.Name="Granny sine band "..i
                playerWave.AssetId="rbxassetid://9040512197"
                playerWave.Looping=true
                playerWave.LoopRegion=NumberRange.new(.2,4.5)
                playerWave.PlaybackRegion=NumberRange.new(.2,4.5)
                playerWave.Volume=0;playerWave.PlaybackSpeed=1
                playerWave.Parent=SoundService
                created[#created+1]=playerWave
                local wire=Instance.new("Wire")
                wire.SourceInstance=playerWave;wire.TargetInstance=output
                wire.Parent=playerWave
                voices[i]=playerWave
                playerWave:Play()
            end
            sineBanks[bank]={waves=voices,clip=nil}
        end
    end)
    if not ok then
        sineBanks=nil
        for _,part in ipairs(created) do pcall(function() part:Destroy() end) end
    else
        for _,part in ipairs(created) do S.resources[#S.resources+1]=part end
    end
end
local nextEffectBank=1
playSynth=function(name,localPos,gain,isMenu)
    if not audioClips then return end
    if name=="__stop_menu" then
        if sineBanks then
            sineBanks[1].clip=nil
            for _,wave in ipairs(sineBanks[1].waves) do wave.Volume=0 end
        end
        return
    end
    local clip=audioClips[name]
    if not clip then return end
    buildSineBanks()
    if not sineBanks then return end
    if isMenu and sineBanks[1].clip==clip then return end
    local bankIndex
    if isMenu then bankIndex=1
    else
        bankIndex=nextEffectBank
        nextEffectBank=3-nextEffectBank
    end
    local bank=sineBanks[bankIndex]
    if localPos and S.origin then
        local distance=(workspace.CurrentCamera.CFrame.Position-(S.origin+localPos)).Magnitude
        gain=(gain or .5)*math.max(0,1-distance/37)
    end
    bank.clip=clip;bank.start=os.clock();bank.gain=gain or .4
    bank.isMenu=isMenu;bank.frame=0
end
local function updateSpectral(dt)
    if not sineBanks then return end
    S.audioClock=(S.audioClock or 0)+dt
    if S.audioClock<1/audioRate then return end
    S.audioClock=0
    local now=os.clock()
    for _,bank in ipairs(sineBanks) do
        local clip=bank.clip
        local frame
        if clip then
            frame=math.floor((now-bank.start)*audioRate)
            if bank.isMenu then frame=frame%clip.frames
            elseif frame>=clip.frames then bank.clip=nil;clip=nil end
        end
        for index,wave in ipairs(bank.waves) do
            if clip then
                local offset=clip.at+frame*8*3+(index-1)*3
                local freq=buffer.readu16(spectrum,offset)
                local amp=buffer.readu8(spectrum,offset+2)
                -- Cap signal energy and avoid seeks/discontinuous sine phases.
                local volume=(amp/255)*(bank.gain or .4)*.22
                wave.Volume=math.min(.42,volume)
                if amp>1 then wave.PlaybackSpeed=math.clamp(freq/440,.18,10) end
                if wave.IsReady and not wave.IsPlaying then wave:Play() end
            elseif wave.Volume~=0 then wave.Volume=0 end
        end
    end
end

local function nearestNav(p)
    local nearest,best=nil,math.huge
    for i,v in ipairs(navPositions) do
        local dx,dy,dz=p.X-v.X,p.Y-v.Y,p.Z-v.Z
        local d=dx*dx+dy*dy*3.5+dz*dz
        if d<best then best=d;nearest=i end
    end
    return nearest
end
local function navPath(start,goal)
    local first,last=nearestNav(start),nearestNav(goal)
    if not first or not last then return nil end
    if first==last then return {goal} end
    local heap={};local cost={[first]=0};local previous={};local done={}
    local function score(a,b)
        local d=navPositions[a]-navPositions[b]
        return d.Magnitude
    end
    local function insert(node,value)
        local i=#heap+1
        while i>1 do
            local parent=math.floor(i/2)
            if heap[parent][2]<=value then break end
            heap[i]=heap[parent];i=parent
        end
        heap[i]={node,value}
    end
    local function remove()
        local firstItem=heap[1];local lastItem=table.remove(heap)
        if #heap>0 then
            local i=1
            while 2*i<=#heap do
                local j=2*i
                if j<#heap and heap[j+1][2]<heap[j][2] then j+=1 end
                if heap[j][2]>=lastItem[2] then break end
                heap[i]=heap[j];i=j
            end
            heap[i]=lastItem
        end
        return firstItem[1]
    end
    insert(first,score(first,last))
    while #heap>0 do
        local node=remove()
        if not done[node] then
            if node==last then break end
            done[node]=true
            local source=navPositions[node]
            for _,nextId in ipairs(navEdges[node]) do
                if not done[nextId] then
                    local delta=navPositions[nextId]-source
                    local newCost=cost[node]+delta.Magnitude
                    if newCost<(cost[nextId] or math.huge) then
                        cost[nextId]=newCost;previous[nextId]=node
                        insert(nextId,newCost+score(nextId,last))
                    end
                end
            end
        end
    end
    if not previous[last] then return nil end
    local result={goal};local cursor=last
    while cursor~=first do
        table.insert(result,1,navPositions[cursor]);cursor=previous[cursor]
        if not cursor then return nil end
    end
    return result
end
local heardQueue={}
local heardSerial=0
local function chooseAIGoal(dt)
    local now=os.clock()
    if not S.active then return nil,nil end
    if insideCloset(S.position) then
        S.lastSeen=nil;S.chaseUntil=0;S.aiSight=false
    elseif now>(S.nextSight or 0) then
        S.nextSight=now+.33
        S.aiSight=seesPlayer()
        if S.aiSight then
            -- Reaching the upstairs sighting can take two real staircases;
            -- do not abandon a valid route after only four seconds.
            S.lastSeen=S.position;S.chaseUntil=now+35
        end
    end
    for _,event in ipairs(noises) do
        if event.id>heardSerial then
            local d=(event.pos-S.grannyPos).Magnitude
            local range=event.range-math.abs(event.pos.Y-S.grannyPos.Y)*.7
            if d<range and now-event.time<11 then
                heardQueue[#heardQueue+1]=event
                if #heardQueue>8 then table.remove(heardQueue,1) end
            end
        end
    end
    heardSerial=noiseSerial
    if S.lastSeen and now<(S.chaseUntil or 0) then
        if S.aiSight then return S.position,"chase" end
        if (S.grannyPos-S.lastSeen).Magnitude>1.5 then
            return S.lastSeen,"search"
        end
    end
    S.lastSeen=nil
    while #heardQueue>0 do
        local event=heardQueue[1]
        if now-event.time>17 then table.remove(heardQueue,1)
        elseif (S.grannyPos-event.pos).Magnitude<1.5 then
            dropTrap(event.pos)
            table.remove(heardQueue,1)
        else return event.pos,"hear" end
    end
    return nil,nil
end
local function grannyUpdate(dt)
    if S.active and not S.cutscene then
        S.aiFrameTime=(S.aiFrameTime or 0)+dt
        if S.aiFrameTime<.048 then return end -- ~20Hz controller, 60Hz avatar
        dt=S.aiFrameTime;S.aiFrameTime=0
    end
    S.grannyT+=dt
    local moving=false
    if S.cutscene then
        S.grannyPos=S.cinPos
        face=Vector3.new(0,0,1)
    elseif S.attackStart then
        local toward=Vector3.new(S.position.X-S.grannyPos.X,0,
            S.position.Z-S.grannyPos.Z)
        if toward.Magnitude>.1 then face=toward.Unit end
    else
        local goal,mode=chooseAIGoal(dt)
        if not goal then
            if S.active then
                if S.patrolTarget and (S.grannyPos-S.patrolTarget).Magnitude<1.05 then
                    S.patrolTarget=nil;S.navGoal=nil;S.navRoute=nil
                    pauseLeft=patrolRng:NextNumber(.75,1.8)
                end
                if pauseLeft>0 then pauseLeft=math.max(0,pauseLeft-dt)
                else
                    if not S.patrolTarget then
                        S.patrolStep=(S.patrolStep or 0)+1
                        local level=patrolSchedule[(S.patrolStep-1)%#patrolSchedule+1]
                        local options=patrolRooms[level]
                        S.patrolTarget=options[patrolRng:NextInteger(1,#options)]
                    end
                    goal=S.patrolTarget;mode="patrol"
                end
            elseif pauseLeft>0 then pauseLeft=math.max(0,pauseLeft-dt)
            else goal=patrol[patrolIndex+1];mode="patrol" end
        end
        if goal then
            local destination=goal
            if mode~="patrol" then
                local clock=os.clock()
                if not S.navGoal or clock>(S.navAfter or 0)
                    or (destination-S.navGoal).Magnitude>2.0 then
                    local directlyVisible=S.aiSight and mode=="chase"
                        and math.abs(destination.Y-S.grannyPos.Y)<2
                        and (destination-S.grannyPos).Magnitude<8
                    if directlyVisible then
                        S.navToken=(S.navToken or 0)+1
                        S.navRoute=nil;S.navGoal=destination
                        S.navAfter=clock+.75
                    else
                        S.navRoute=navPath(S.grannyPos,destination)
                        S.navIndex=1;S.navGoal=destination
                        S.navAfter=clock+(mode=="chase" and .8 or 2.1)
                    end
                end
            else
                local clock=os.clock()
                if not S.navGoal or (destination-S.navGoal).Magnitude>1.1
                    or clock>(S.navAfter or 0) then
                    S.navRoute=navPath(S.grannyPos,destination)
                    S.navIndex=1;S.navGoal=destination;S.navAfter=clock+4
                end
            end
            local waypoint=destination
            local route=S.navRoute
            if route then
                local idx=S.navIndex or 1
                while idx<=#route and (S.grannyPos-route[idx]).Magnitude<.82 do
                    idx+=1
                end
                S.navIndex=idx
                if idx<=#route then waypoint=route[idx] end
            end
            local delta=Vector3.new(waypoint.X-S.grannyPos.X,0,waypoint.Z-S.grannyPos.Z)
            local distance=delta.Magnitude
            local speed=mode=="chase" and 3.75 or mode=="hear" and 2.95 or 2.55
            local inRamp=(math.abs(S.grannyPos.X-5.85)<2.05
                    and S.grannyPos.Z>-4.15 and S.grannyPos.Z<8.15
                    and S.grannyPos.Y>6.8 and S.grannyPos.Y<14.1)
                or (math.abs(S.grannyPos.X+4.65)<2.0
                    and S.grannyPos.Z>2.55 and S.grannyPos.Z<10.2
                    and S.grannyPos.Y>12.8 and S.grannyPos.Y<20.45)
            if distance>.04 then
                local direction=delta/distance
                face=(face:Lerp(direction,clamp(dt*6,0,1))).Unit
                local advance=math.min(distance,speed*dt)
                local candidate=S.grannyPos+direction*advance
                local floor=floorAt(candidate,1.1,1.25)
                if inRamp and route and math.abs(waypoint.Y-S.grannyPos.Y)>.16 then
                    -- A basement floor lies DIRECTLY below the source ramp.
                    -- floorAt() picks that higher candidate and strands Granny
                    -- underneath the stairs. Follow the baked ramp elevation.
                    floor=S.grannyPos.Y+(waypoint.Y-S.grannyPos.Y)
                        *clamp(advance/distance,0,1)
                end
                if floor>-1e5 and math.abs(floor-S.grannyPos.Y)<1.25 then
                    candidate=Vector3.new(candidate.X,floor,candidate.Z)
                    local pushed=wallPush(candidate,.43,3.2)
                    local move=pushed-S.grannyPos
                    if (pushed-candidate).Magnitude<.85 and move.Magnitude>.018 then
                        -- Collision jitter is not walking. Require progress
