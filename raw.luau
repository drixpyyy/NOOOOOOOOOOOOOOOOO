    local to=S.position+Vector3.new(0,2.0,0)
    local diff=to-from;local length=diff.Magnitude
    if length>16 or length<.25 or math.abs(S.position.Y-S.grannyPos.Y)>3.2 then
        return false
    end
    local horizontal=Vector3.new(diff.X,0,diff.Z)
    if horizontal.Magnitude>.4 and face:Dot(horizontal.Unit)<.76 then
        return false -- intentionally poor side/peripheral vision
    end
    return visionClear(from,to)
end
