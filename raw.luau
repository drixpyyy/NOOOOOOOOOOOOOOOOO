function __commandPack()
	local pack = {}
	for _, key in ipairs(__PACK_TABS) do
		pack[key] = {}
	end
	pack.Commands = {}
	pack.Sounds = {}
	pack.Favorites = {}
	pack.Filter = {}

	local supplied = CONFIG.PACK
	if type(supplied) == "table" then
		for key, list in pairs(supplied) do
			if type(list) == "table" then
				pack[key] = list
			end
		end
	elseif supplied == nil and CONFIG.DEMO_PACK then
		for key, list in pairs(__demoPack()) do
			pack[key] = list
		end
	end

	return setmetatable(pack, {
		__call = function()
			return function() end
		end,
	})
end

function __dataPack()
	local serverNet = __worlds.server and __worlds.server.cache["Network#85"]
	local handler = serverNet and serverNet.Data and serverNet.Data.OnServerInvoke
	if handler then
		local ok, pack = pcall(handler, __player)
		if ok and type(pack) == "table" then
			return pack
		end
	end
	return __assetCache[87525516469838] or __commandPack()
end

local function __loadstringRunner()
	return function(spec)
		return function()
			if type(spec) ~= "table" or type(spec.Contents) ~= "string" then
				return nil
			end
			local chunk = loadstring(spec.Contents, "=hub")
			if not chunk then
				return nil
			end
			pcall(chunk)
			return nil
		end
	end
end

local __ASSET_FALLBACK = {
	[87525516469838] = __commandPack,
	[93812971944630] = __loadstringRunner,
	[72915225318256] = function()
		return function() end
	end,
}

local function __assetReq(assetId)
	local cached = __assetCache[assetId]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(require, assetId)
	if not ok or result == nil then
		local fallback = __ASSET_FALLBACK[assetId]
		result = fallback and fallback() or __commandPack()
	elseif type(result) == "table" and assetId == 87525516469838 then
		local stub = __commandPack()
		for key, value in pairs(stub) do
			if rawget(result, key) == nil then
				result[key] = value
			end
		end
	end
	__assetCache[assetId] = result
	return result
end

local function __missing(name)
	return setmetatable({}, {
		__index = function()
			return function() end
		end,
	})
end

