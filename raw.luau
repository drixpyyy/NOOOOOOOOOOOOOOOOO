                v=Vector3.new(v.X*.77,math.abs(v.Y)>.85 and -v.Y*.2 or 0,v.Z*.77)
            end
            if pos.Y<2 then pos=g.center;v=Vector3.zero end
            g.pos=pos;g.velocity=v
