    local minY,maxY=math.min(origin.Y,target.Y)-.2,math.max(origin.Y,target.Y)+.2
    -- Traverse each 4x4 source-collision cell at most ONCE. The prior method
    -- allocated a 3x3 neighborhood for EVERY sub-stud sample along the ray.
    for i=0,math.ceil(length/1.25) do
        local p=origin+direction*math.min(length,i*1.25)
        local cx,cz=math.floor(p.X/cell),math.floor(p.Z/cell)
        local id=hash(cx,cz)
        if not visitedCells[id] then
            visitedCells[id]=true
            local list=grid[id]
            if list then
                for _,faceIndex in ipairs(list) do
                    if not testedFaces[faceIndex] then
                        testedFaces[faceIndex]=true
                        local t=tris[faceIndex]
                        if t.ymax>=minY and t.ymin<=maxY then
                            local hit=rayFace(origin,direction,t.a,t.b,t.c)
                            if hit and hit<length-.3 then return false end
                        end
                    end
                end
            end
        end
    end
    -- Dynamic authored doors: only examine a door if its center is close to
    -- this ray, not every leaf on Granny's floor.
    for _,g in ipairs(groups) do
        if g.kind==0 and not g.hidden then
            local deltaToDoor=g.center-origin
            local along=direction:Dot(deltaToDoor)
            local away=(deltaToDoor-direction*along).Magnitude
            if along>-.5 and along<length+.5 and away<2.3 then
                for _,f in ipairs(g.faces) do
                    local hit=rayFace(origin,direction,g.vertices[f[1]].current,
                        g.vertices[f[2]].current,g.vertices[f[3]].current)
                    if hit and hit<length-.3 then return false end
                end
            end
        end
    end
    return true
end
