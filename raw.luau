	AimbotRunAlready = true
	cmdm.KeyDown:connect(function(Key)
		Key = Key:lower():byte()
		if AimbotIs and Key == Hotkey then
			AimbotEnabled = true
		end
	end)
	cmdm.KeyUp:connect(function(Key)
		Key = Key:lower():byte()
		if AimbotIs and Key == Hotkey then
