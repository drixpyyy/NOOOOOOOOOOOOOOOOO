    end
end

local function triggerBlackout(epoch)
    if S.powerBusy or not S.powerOn or not S.alive then return end
    S.powerBusy = true

    -- Pre-blackout flicker warning
    for _, delayLen in ipairs({ 0.09, 0.08, 0.14 }) do
        if not S.alive or S.powerEpoch ~= epoch then S.powerBusy = false return end
        setLightsState(false)
        task.wait(delayLen)
        if not S.alive or S.powerEpoch ~= epoch then S.powerBusy = false return end
        setLightsState(true)
        task.wait(delayLen * 1.4)
    end

    S.powerOn = false
    updateHudStatus()
    setLightsState(false)

    local sPowerOff = wsSounds["314221915"]
    if sPowerOff then
        sPowerOff.Volume = 0.85
        sPowerOff.Looped = false
        pcall(function() sPowerOff:Play() end)
    end

    local sAlarm = wsSounds["9113085665"]
    local sScary = wsSounds["2893921424"]
    local sThreat = wsSounds["1841798430"]

    task.delay(0.45, function()
        if not S.alive or S.powerOn or S.powerEpoch ~= epoch then return end
        if sAlarm then
            sAlarm.Volume = 0.42
            sAlarm.Looped = true
            pcall(function() sAlarm:Play() end)
        end
        if sScary then
            sScary.Volume = 0.52
            sScary.Looped = true
            pcall(function() sScary:Play() end)
        end
        task.delay(6.0, function()
            if sAlarm and sAlarm.Parent then
                pcall(function() sAlarm:Stop() end)
            end
        end)
        task.delay(10.0, function()
            if not S.alive or S.powerOn or S.powerEpoch ~= epoch then return end
            if sThreat then
                sThreat.Volume = 0.42
                sThreat.Looped = false
                pcall(function() sThreat:Play() end)
            end
        end)
    end)

    S.powerBusy = false
end

local function restorePower(epoch)
    if S.powerBusy or S.powerOn or not S.alive then return end
    S.powerBusy = true

    stopOutageAudio()

    local sTurnOn = wsSounds["156221488"]
    if sTurnOn then
        sTurnOn.Volume = 0.80
        sTurnOn.Looped = false
        pcall(function() sTurnOn:Play() end)
    end

    -- Staggered light restoration in 3 waves
    for wave = 1, 3 do
        if not S.alive or S.powerEpoch ~= epoch then S.powerBusy = false return end
        setLightsState(true, function(idx) return (idx % 3) + 1 == wave end)
        task.wait(0.28)
    end

    S.powerOn = true
    updateHudStatus()
    setLightsState(true)
    S.powerBusy = false
end

local function togglePowerManual()
    if S.powerBusy or not S.alive then return end
    S.powerEpoch += 1
    local myEpoch = S.powerEpoch
    task.spawn(function()
        if S.powerOn then
            triggerBlackout(myEpoch)
        else
            restorePower(myEpoch)
        end
    end)
end

-- Background automatic ambient outage cycle
task.spawn(function()
    while S.alive do
        local myEpoch = S.powerEpoch
        local waitOn = math.random(75, 115)
        local t0 = os.clock()
        while S.alive and S.powerEpoch == myEpoch and (os.clock() - t0 < waitOn) do
            task.wait(0.5)
        end
        if not S.alive then break end
        if S.powerEpoch ~= myEpoch then continue end

        if S.powerOn then
            triggerBlackout(myEpoch)
        end

        local waitOff = math.random(24, 34)
        t0 = os.clock()
        while S.alive and S.powerEpoch == myEpoch and (os.clock() - t0 < waitOff) do
            task.wait(0.5)
        end
        if not S.alive then break end
        if S.powerEpoch ~= myEpoch then continue end

        if not S.powerOn then
            restorePower(myEpoch)
        end
    end
end)

