function BodyAimbot(aimbotarg)
	local AimFor = "Head"
	if aimbotarg == "Team" then Teamed = true else Teamed = false end
	local Hotkey = 50
	AimbotIs = true
	opx("-","Aimbot enabled (Hold down Left Ctrl to aim)")
