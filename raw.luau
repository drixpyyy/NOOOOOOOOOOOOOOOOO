local __mirror = {}
local __root, __packages, __bundleScript

local function __makeInstance(class, name, parent)
	local inst = Instance.new(class)
	inst.Name = name
	inst.Parent = parent
	return inst
end

local function __bootstrap()
	local existing
	if CONFIG.REUSE_EXISTING and LocalPlayer then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then
			for _, gui in ipairs(playerGui:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Name == "GuiMain" and gui:FindFirstChildWhichIsA("Folder") then
					existing = gui
					break
				end
			end
		end
	end

	local root = existing
	if not root then
		root = Instance.new("ScreenGui")
		root.Name = "GuiMain"
		root.ResetOnSpawn = false
		root.IgnoreGuiInset = true
		root.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		if LocalPlayer then
			root.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer
		end
	end

	if root:GetAttribute("Mode") == nil then
		root:SetAttribute("Mode", CONFIG.MODE)
	end
	if root:GetAttribute("Color") == nil then
		root:SetAttribute("Color", CONFIG.COLOR)
	end

	local packages = root:FindFirstChild("Packages")
	if not packages then
		packages = __makeInstance("Folder", "Packages", root)
	end

	local scriptStub = root:FindFirstChild("SensationHub")
	if not scriptStub then
		scriptStub = __makeInstance("LocalScript", "SensationHub", root)
	end

	return root, packages, scriptStub
end

__root, __packages, __bundleScript = __bootstrap()

local function __ctx(id)
	local cached = __mirror[id]
	if cached then
		return cached
	end
	local path = __paths[id]
	if not path then
		return __bundleScript
	end
	local node = __root
	local segments = {}
	for segment in string.gmatch(path, "[^/]+") do
		table.insert(segments, segment)
	end
	for i = 1, #segments do
		local name = segments[i]
		local child = node:FindFirstChild(name)
		if not child then
			child = __makeInstance(i == #segments and "ModuleScript" or "Folder", name, node)
		end
		node = child
	end
	__mirror[id] = node
	return node
end

for id in pairs(__paths) do
	__ctx(id)
end

local __defs = {}

local function __signal()
	local s = { fns = {}, waits = {} }
	local sig = {}

	function sig:Connect(fn)
		local conn = { Connected = true }
		s.fns[conn] = fn
		function conn:Disconnect()
			s.fns[self] = nil
			self.Connected = false
		end
		return conn
	end

	function sig:ConnectAsync(fn)
		return self:Connect(fn)
	end

	function sig:Once(fn)
		local conn
		conn = self:Connect(function(...)
			if conn.Connected then
				conn:Disconnect()
			end
			return fn(...)
		end)
		return conn
	end

	function sig:Wait()
		local co = coroutine.running()
		if not co then
			return nil
		end
		s.waits[#s.waits + 1] = co
		return coroutine.yield()
	end

	function sig:Fire(...)
		local pending = {}
		for conn, fn in pairs(s.fns) do
			if conn.Connected then
				pending[#pending + 1] = fn
			end
		end
		for _, fn in ipairs(pending) do
			pcall(fn, ...)
		end
		if #s.waits > 0 then
			local waits = s.waits
			s.waits = {}
			for _, co in ipairs(waits) do
				if type(co) == "thread" and coroutine.status(co) == "suspended" then
					coroutine.resume(co, ...)
				end
			end
		end
	end

	return sig
end

local __transports = {}
local __linkC2S, __linkS2C = {}, {}
local __player
local __commandPack
local __dataPack

local function __transport(name)
	local existing = __transports[name]
	if existing then
		return existing
	end

	local t = {
		Name = name,
		ClassName = "RemoteEvent",
		_attrs = {},
		_attrSignals = {},
		OnServerEvent = __signal(),
		OnClientEvent = __signal(),
	}
	t.OnServerInvoke = nil
	t.OnClientInvoke = nil

	function t:IsA(class)
		return class == "RemoteEvent" or class == "Instance"
	end

	function t:GetAttribute(key)
		return self._attrs[key]
	end

	function t:SetAttribute(key, value)
		self._attrs[key] = value
		local sig = self._attrSignals[key]
		if not sig then
			sig = __signal()
			self._attrSignals[key] = sig
		end
		sig:Fire(value)
	end

	function t:GetAttributeChangedSignal(key)
		local sig = self._attrSignals[key]
		if not sig then
			sig = __signal()
			self._attrSignals[key] = sig
		end
		return sig
	end

	function t:FireServer(...)
		__linkC2S[#__linkC2S + 1] = { t, table.pack(...) }
	end

	function t:FireClient(plr, ...)
		if plr ~= nil and plr ~= __player then
			return
		end
		__linkS2C[#__linkS2C + 1] = { t, table.pack(...) }
	end

	function t:FireClients(list, ...)
		for _, plr in pairs(list) do
			if plr == __player then
				__linkS2C[#__linkS2C + 1] = { t, table.pack(...) }
				return
			end
		end
	end

	function t:FireAllClients(...)
		__linkS2C[#__linkS2C + 1] = { t, table.pack(...) }
	end

	function t:FireAllExcept(plr, ...)
		if plr ~= __player then
			__linkS2C[#__linkS2C + 1] = { t, table.pack(...) }
		end
	end

	function t:Destroy()
		__transports[name] = nil
	end

	__transports[name] = t
	return t
end

local __pumpEvent = RunService.PostSimulation or RunService.Heartbeat
__pumpEvent:Connect(function()
	local c2s, s2c = __linkC2S, __linkS2C
	if #c2s > 0 then
		__linkC2S = {}
	end
	if #s2c > 0 then
		__linkS2C = {}
	end
	for _, msg in ipairs(c2s) do
		msg[1].OnServerEvent:Fire(__player, table.unpack(msg[2], 1, msg[2].n))
	end
	for _, msg in ipairs(s2c) do
		msg[1].OnClientEvent:Fire(table.unpack(msg[2], 1, msg[2].n))
	end
end)

local __NIL = newproxy and newproxy() or {}
local __proxy

function __proxy(real, overrides)
	local p = {}
	local mt = {}
	mt.__index = function(_, key)
		local over = overrides[key]
		if over ~= nil then
			if over == __NIL then
				return nil
			end
			return over
		end
		local value = real[key]
		if type(value) == "function" then
			return function(_, ...)
				return value(real, ...)
			end
		end
		return value
	end
	mt.__newindex = function(_, key, value)
		overrides[key] = value
	end
	mt.__eq = function(a, b)
		return rawequal(a, real) or rawequal(b, real)
	end
	mt.__tostring = function()
		return tostring(real)
	end
	return setmetatable(p, mt)
end

local __worlds = {}

local function __makeWorld(role)
	local isServer = (role == "server")
	local world = { role = role, cache = {}, loading = {} }

	local runService = __proxy(RunService, {
		IsServer = function()
			return isServer
		end,
		IsClient = function()
			return not isServer
		end,
		IsStudio = function()
			return false
		end,
		IsRunning = function()
			return true
		end,
	})

	local env = {
		game = game,
		workspace = workspace,
		script = __bundleScript,
		runService = runService,
		root = __root,
		dataPack = function()
			return __dataPack()
		end,
		commandPack = function()
			return __commandPack()
		end,
	}

	world.env = env
	world.game = game

	local req
	req = function(id)
		local cached = world.cache[id]
		if cached ~= nil then
			return cached
		end
		if world.loading[id] then
			error("[cyclic] " .. tostring(id), 2)
		end
		local def = __defs[id]
		if not def then
			error("[missing] " .. tostring(id), 2)
		end
		world.loading[id] = true
		env.script = __ctx(id)
		local ok, value = pcall(def, env, req)
		env.script = __bundleScript
		world.loading[id] = nil
		if not ok then
			error("[" .. role .. "] " .. tostring(id) .. ": " .. tostring(value), 0)
		end
		world.cache[id] = value
		return value
	end
	world.req = req
	return world
end

