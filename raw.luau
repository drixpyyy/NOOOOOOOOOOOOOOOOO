local function atlasImage(a)
    local ok,image=pcall(function() return AS:CreateEditableImage({Size=Vector2.new(a.w,a.h)}) end)
    if not ok or not image then warn("EditableImage permission/budget: "..tostring(image));return nil end
    local pixels=buffer.create(a.w*a.h*4)
    local bw=a.w/4;local count=bw*(a.h/4)
    for bi=0,count-1 do
        local block=a.offset+bi*(a.typ==3 and 16 or 8)
        local ci=block+(a.typ==3 and 8 or 0)
        local c0,c1=buffer.readu16(raw,ci),buffer.readu16(raw,ci+2)
        local bits=buffer.readu32(raw,ci+4)
        local function rgb(v)
            return math.floor(bit32.extract(v,11,5)*255/31+.5),math.floor(bit32.extract(v,5,6)*255/63+.5),math.floor(bit32.extract(v,0,5)*255/31+.5)
        end
        local r0,g0,b0=rgb(c0);local r1,g1,b1=rgb(c1)
        local colors={{r0,g0,b0},{r1,g1,b1},{math.floor((2*r0+r1)/3),math.floor((2*g0+g1)/3),math.floor((2*b0+b1)/3)},
            {math.floor((r0+2*r1)/3),math.floor((g0+2*g1)/3),math.floor((b0+2*b1)/3)}}
        local a0,a1,alphaBits=255,255,0
        local alphas=nil
        if a.typ==3 then
            a0=buffer.readu8(raw,block);a1=buffer.readu8(raw,block+1)
            alphaBits=buffer.readu32(raw,block+2)+buffer.readu16(raw,block+6)*4294967296
            alphas={a0,a1}
            if a0>a1 then for k=1,6 do alphas[k+2]=math.floor(((7-k)*a0+k*a1)/7+.5) end
            else for k=1,4 do alphas[k+2]=math.floor(((5-k)*a0+k*a1)/5+.5) end;alphas[7]=0;alphas[8]=255 end
        end
