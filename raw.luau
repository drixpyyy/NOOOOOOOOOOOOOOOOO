                if horizontal<math.max(g.upper.X-g.lower.X,g.upper.Z-g.lower.Z)*.65+radius+.7 then
                    for _,f in ipairs(g.faces) do
                        local a,b,c=g.vertices[f[1]].current,g.vertices[f[2]].current,g.vertices[f[3]].current
