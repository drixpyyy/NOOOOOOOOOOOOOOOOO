    local out=buffer.create(math.floor(#navEncoded/5)*4)
    local at,val,k=0,0,0
    for i=1,#navEncoded do
        local byte=string.byte(navEncoded,i)
        if byte>32 then
            val+=(lookup[byte] or 0)*85^k;k+=1
            if k==5 then buffer.writeu32(out,at,val);at+=4;k=0;val=0 end
        end
    end
    navEncoded=nil
    local offset=0
    local count=buffer.readu16(out,offset);offset+=2
    local places=table.create(count);local links=table.create(count)
    for i=1,count do
        places[i]=Vector3.new(buffer.readi16(out,offset)/100,
            buffer.readi16(out,offset+2)/100,buffer.readi16(out,offset+4)/100)
        offset+=6
        local countLinks=buffer.readu8(out,offset);offset+=1
        local list=table.create(countLinks)
        for j=1,countLinks do list[j]=buffer.readu16(out,offset);offset+=2 end
        links[i]=list
    end
    return places,links
end
