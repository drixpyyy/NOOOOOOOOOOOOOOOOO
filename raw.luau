-- SYSTEM 2: RECONSTRUCTED 6 COLORED PADS & TURRETHOLE SHAPE CHUTES
-- =====================================================================
local chuteParts = {}
for _, idx in ipairs(MAP_DATA.chuteIndices) do
    if builtParts[idx] then
        table.insert(chuteParts, builtParts[idx])
    end
end

local shapeTypes = {
    Enum.PartType.Block,
    Enum.PartType.Ball,
    Enum.PartType.Cylinder,
}

local function findNearestChute(padPos)
    local best, bestDist = nil, math.huge
    for _, ch in ipairs(chuteParts) do
        local dx = ch.Position.X - padPos.X
        local dz = ch.Position.Z - padPos.Z
        local d = dx * dx + dz * dz
        if d < bestDist then
            bestDist = d
            best = ch
        end
    end
    return best
end

for _, idx in ipairs(MAP_DATA.padIndices) do
    local pad = builtParts[idx]
    if pad then
        local upCF = pad.CFrame
        local downCF = upCF - Vector3.new(0, 0.16, 0)
        local chute = findNearestChute(pad.Position)
        local lastPress = 0

        local click = Instance.new("ClickDetector")
        click.MaxActivationDistance = 14
        click.Parent = pad

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Dispense Shape"
        prompt.ObjectText = "Chute Pad"
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 7
        prompt.RequiresLineOfSight = false
        prompt.Parent = pad

        local function triggerPad()
            if not S.alive then return end
            local now = os.clock()
            if now - lastPress < 0.6 then return end
            lastPress = now

            local snd = padSoundByPart[pad]
            if snd then
                pcall(function()
                    snd.TimePosition = 0
                    snd:Play()
                end)
            end

            local twDown = TweenService:Create(pad, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = downCF })
            twDown:Play()
            task.delay(0.14, function()
                if pad.Parent then
                    TweenService:Create(pad, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = upCF }):Play()
                end
            end)

            if chute then
                local dropLight = Instance.new("PointLight")
                dropLight.Color = pad.Color
                dropLight.Brightness = 2.5
                dropLight.Range = 18
                dropLight.Parent = chute
                Debris:AddItem(dropLight, 0.55)

                local shape
                local pick = math.random(1, 4)
                if pick <= 3 then
                    shape = Instance.new("Part")
                    shape.Shape = shapeTypes[pick]
                else
                    shape = Instance.new("WedgePart")
                end
                shape.Name = "DispensedShape"
                local sz = 2.2
                shape.Size = Vector3.new(sz, sz, sz)
                shape.Color = pad.Color
                shape.Material = Enum.Material.SmoothPlastic
                shape.Anchored = false
                shape.CanCollide = true
                shape.CFrame = CFrame.new(
                    chute.Position.X + (math.random() - 0.5) * 1.4,
                    chute.Position.Y - 2.4,
                    chute.Position.Z + (math.random() - 0.5) * 1.4
                ) * CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3)
                shape.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 2, -14, (math.random() - 0.5) * 2)
                shape.AssemblyAngularVelocity = Vector3.new(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3))
                shape.Parent = folders.SpawnedShapes

                table.insert(S.spawnedShapes, shape)
                while #S.spawnedShapes > 28 do
                    local oldest = table.remove(S.spawnedShapes, 1)
                    if oldest and oldest.Parent then
                        oldest:Destroy()
                    end
                end
            end
        end

        conn(click.MouseClick, function(who)
            if not who or who == player then
                triggerPad()
            end
        end)
        conn(prompt.Triggered, function(who)
            if not who or who == player then
                triggerPad()
            end
        end)
        conn(pad.Touched, function(hit)
            local ch = player.Character
            if ch and hit and hit:IsDescendantOf(ch) then
                triggerPad()
            end
        end)
    end
end

