        local ix=triAt+i*6
        local a,b,c=buffer.readu16(raw,ix)+1,buffer.readu16(raw,ix+2)+1,buffer.readu16(raw,ix+4)+1
        local f=em:AddTriangle(ids[a],ids[b],ids[c])
        em:SetFaceUVs(f,{uvs[a],uvs[b],uvs[c]})
        if i%3000==0 then task.wait() end
